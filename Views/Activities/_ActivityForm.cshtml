@* نموذج إضافة/تعديل نشاط (مشترك بين Create و Edit) — يعتمد على articles-create.css *@
@model Activity
@{
    var isEdit = Model.Id > 0;
}
<form id="activityForm" asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    @if (isEdit)
    {
        <input type="hidden" asp-for="Id" />
    }
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

    @if (isEdit && !string.IsNullOrEmpty(Model.ImagePath))
    {
        <label class="form-label">الصورة الحالية</label>
        <div class="current-file-card">
            <div class="file-right">
                <img src="@Model.ImagePath" alt="current image" />
            </div>
            <div class="file-middle">
                <div class="file-name">@System.IO.Path.GetFileName(Model.ImagePath)</div>
                <div class="file-status">
                    <span class="file-size">Uploaded</span>
                    <span class="file-check"><i class="fa-solid fa-circle-check"></i></span>
                </div>
            </div>
        </div>
    }

    <label class="form-label">@(isEdit ? "تغيير صورة النشاط (اختياري)" : "صورة النشاط")</label>
    <div class="upload-area" id="dropzone">
        <input type="file" id="fileInput" name="Image" hidden accept="image/*" />
        <div class="upload-icon-wrapper"><i class="fa-solid fa-cloud-arrow-up"></i></div>
        <div class="upload-text-main">اسحب الملف هنا أو <span>تصفح من جهازك</span></div>
        <div class="upload-hint">JPEG, PNG (حد أقصى 5MB)</div>
        <div id="previewContainer" class="mt-3 d-none">
            <span class="badge bg-success" id="fileNameDisplay">تم اختيار ملف</span>
        </div>
    </div>
    <span class="text-danger small">@Html.ValidationMessage("Image")</span>

    <div class="row">
        <div class="col-12">
            <label class="form-label">عنوان النشاط بالعربي</label>
            <input asp-for="TitleAr" class="custom-input" placeholder="مثال: ورشة كتابة السيرة الذاتية" />
            <span asp-validation-for="TitleAr" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label class="form-label">عنوان النشاط بالانجليزي</label>
            <input asp-for="TitleEn" class="custom-input" placeholder="Activity title in English" />
            <span asp-validation-for="TitleEn" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label class="form-label">عنوان النشاط بالفرنسي</label>
            <input asp-for="TitleFr" class="custom-input" placeholder="Titre de l'activité en français" />
            <span asp-validation-for="TitleFr" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label">تاريخ البداية</label>
            <input asp-for="StartDate" type="date" asp-format="{0:yyyy-MM-dd}" class="custom-input" />
            <span asp-validation-for="StartDate" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">تاريخ النهاية (اختياري)</label>
            <input asp-for="EndDate" type="date" asp-format="{0:yyyy-MM-dd}" class="custom-input" />
            <span asp-validation-for="EndDate" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label">المكان (اختياري)</label>
            <input asp-for="Location" class="custom-input" placeholder="مثال: رام الله، أو عن بُعد" />
        </div>
        <div class="col-md-6">
            <label class="form-label">رابط التسجيل أو التغطية (اختياري)</label>
            <input asp-for="ExternalLink" class="custom-input" dir="ltr" placeholder="https://..." />
            <span asp-validation-for="ExternalLink" class="text-danger small"></span>
        </div>

        <div class="col-12">
            <label class="form-label">المشروع الرائد الذي يتبعه النشاط (اختياري)</label>
            <select asp-for="ProgramId" asp-items="@(ViewBag.Programs as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)" class="custom-input">
                <option value="">— نشاط مستقل —</option>
            </select>
        </div>

        <div class="col-12 mt-2">
            <label class="form-label d-flex align-items-center gap-2" style="cursor:pointer">
                <input asp-for="IsPublished" type="checkbox" style="width:18px;height:18px;accent-color:#25652C" />
                منشور (غير المنشور يظهر للأدمن فقط)
            </label>
        </div>
    </div>

    <div class="editor-container">
        <label class="form-label">وصف النشاط بالعربي</label>
        <div id="editorAr" style="height:200px;background:#fff"></div>
        <input type="hidden" asp-for="DescriptionAr" id="DescriptionAr" />
        <span asp-validation-for="DescriptionAr" class="text-danger small"></span>
    </div>
    <div class="editor-container">
        <label class="form-label">وصف النشاط بالانجليزي</label>
        <div id="editorEn" style="height:200px;background:#fff"></div>
        <input type="hidden" asp-for="DescriptionEn" id="DescriptionEn" />
        <span asp-validation-for="DescriptionEn" class="text-danger small"></span>
    </div>
    <div class="editor-container">
        <label class="form-label">وصف النشاط بالفرنسي</label>
        <div id="editorFr" style="height:200px;background:#fff"></div>
        <input type="hidden" asp-for="DescriptionFr" id="DescriptionFr" />
        <span asp-validation-for="DescriptionFr" class="text-danger small"></span>
    </div>

    <div class="hint-text">
        <span class="hint-dot"></span>
        <span>يُعرض النشاط في صفحة "نشاطاتنا" بكل من العربية، الإنجليزية، الفرنسية</span>
    </div>

    <div class="actions-group">
        <button type="submit" class="btn-publish">@(isEdit ? "حفظ التعديلات" : "حفظ النشاط")</button>
        <a asp-action="Index" class="btn-cancel">إلغاء</a>
    </div>
</form>
