@model Foras_Khadra.Models.UserDashboardViewModel
@using Foras_Khadra.Helpers
@using Foras_Khadra.Models
@{
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var pageTitle = lang == "en" ? "My page" : lang == "fr" ? "Ma page" : "صفحتي";
    ViewData["Title"] = pageTitle;
    ViewData["Description"] = pageTitle;

    string T(string ar, string en, string fr) => lang == "en" ? en : lang == "fr" ? fr : ar;
    ViewData["MatchScores"] = Model.MatchScores; // شارة "تطابق N%" على بطاقات _OpportunityCard
    ViewData["NewSince"] = Model.NewSince;       // شارة "جديد" (4-1)
    ViewData["SaveCounts"] = Model.SaveCounts;   // "N حفظوها" (4-3)
}

<link asp-append-version="true" rel="stylesheet" href="~/css/all-opportunities.css" />
<link asp-append-version="true" rel="stylesheet" href="~/css/tracker.css" />

<style>
    /* ====== صفحتي — بتصميم الهوية البصرية (brand.css) ====== */
    body { background: var(--fk-bg); }

    .fk-dash {
        font-family: var(--fk-font-body);
        color: var(--fk-ink);
    }

    /* ورقتا الشعار — زخرفة SVG مضمّنة */
    .fk-leaves { flex: none; }

    /* فاصل قاعدة الحاسوب من الشعار: شريط ونقاط */
    .fk-divider {
        display: flex;
        align-items: center;
        gap: 7px;
        margin: 14px 0 0;
    }

    .fk-divider .bar {
        height: 7px;
        border-radius: 999px;
        background: var(--fk-orange);
        width: 90px;
    }

    .fk-divider .bar:first-child { width: 150px; }
    .fk-divider .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--fk-orange);
    }

    /* ===== الترويسة ===== */
    .fk-hero {
        background: #fff;
        border: 1px solid #e6efe6;
        border-radius: 24px;
        padding: 34px 32px 30px;
        margin: 26px 0 26px;
        position: relative;
        overflow: hidden;
    }

    /* حلقات العلامة باهتة في زاوية الترويسة */
    .fk-hero::after {
        content: "";
        position: absolute;
        inset-inline-end: -70px;
        top: -70px;
        width: 230px;
        height: 230px;
        border: 26px solid var(--fk-leaf);
        border-radius: 50%;
        opacity: 0.22;
        pointer-events: none;
    }

    .fk-hero h1 {
        font-family: var(--fk-font-head);
        color: var(--fk-green);
        font-size: 2rem;
        font-weight: 700;
        margin: 0 0 8px;
        position: relative;
    }

    /* تمييز الاسم بخط ورقي تحته كما في منشورات الهوية */
    .fk-hero h1 .hl {
        background: linear-gradient(to top, color-mix(in srgb, var(--fk-leaf) 55%, transparent) 32%, transparent 32%);
        padding: 0 4px;
        border-radius: 4px;
    }

    .fk-hero .sub {
        margin: 0;
        color: #4a5f4c;
        font-weight: 400;
        font-size: 1.02rem;
    }

    .fk-hero .tag {
        display: inline-block;
        margin-top: 14px;
        color: var(--fk-green);
        font-weight: 600;
        font-size: 0.9rem;
        letter-spacing: 0.2px;
    }

    /* ===== بطاقات الأرقام ===== */
    .fk-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 14px;
        margin-bottom: 30px;
    }

    .fk-stat {
        border-radius: 18px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        border: 1px solid transparent;
    }

    .fk-stat i { font-size: 1.5rem; }

    .fk-stat strong {
        font-family: var(--fk-font-head);
        font-size: 1.7rem;
        line-height: 1;
        display: block;
    }

    .fk-stat span { font-weight: 600; font-size: 0.92rem; }

    .fk-stat.saved { background: var(--fk-leaf-soft); border-color: #d9eec4; color: var(--fk-green); }
    .fk-stat.expiring { background: var(--fk-orange-soft); border-color: #fbe0b8; color: #b06410; }
    .fk-stat.picked { background: var(--fk-sky-soft); border-color: #c8ebf4; color: #1a7f9c; }

    /* ===== شريط المواعيد القريبة ===== */
    .fk-expiring {
        background: #fff;
        border: 1px solid #fbe0b8;
        border-inline-start: 5px solid var(--fk-orange);
        border-radius: 16px;
        padding: 16px 20px;
        margin-bottom: 30px;
    }

    .fk-expiring-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: var(--fk-font-head);
        font-weight: 700;
        color: #b06410;
        margin-bottom: 10px;
    }

    .fk-expiring ul {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .fk-expiring li a {
        color: var(--fk-ink);
        font-weight: 600;
        text-decoration: none;
    }

    .fk-expiring li a:hover { color: var(--fk-green); }

    .fk-expiring .days-left {
        color: var(--fk-orange);
        font-size: 0.85rem;
        font-weight: 700;
        white-space: nowrap;
    }

    /* ===== الأقسام ===== */
    .fk-section { margin-bottom: 46px; }

    .fk-section-head {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 6px;
        flex-wrap: wrap;
    }

    .fk-section-head h2 {
        font-family: var(--fk-font-head);
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--fk-green);
    }

    .fk-section-head .view-all {
        margin-inline-start: auto;
        color: var(--fk-orange);
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
        font-size: 0.95rem;
    }

    .fk-section-head .view-all:hover { text-decoration: underline; }

    .fk-section-sub {
        color: #5c715e;
        font-size: 0.93rem;
        margin: 0 0 16px;
    }

    .fk-section .row { margin-top: 2px; }

    /* رقائق الاهتمامات */
    .fk-chips {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin: 10px 0 18px;
    }

    .fk-chip {
        background: #fff;
        border: 1.5px solid var(--fk-leaf);
        color: var(--fk-green);
        border-radius: 999px;
        padding: 5px 14px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .fk-chips .edit {
        color: #7a8c7c;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
    }

    .fk-chips .edit:hover { color: var(--fk-green); }

    /* اكتمال الملف (4-4) */
    .fk-profile {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 18px;
        padding: 12px 16px;
        background: var(--fk-orange-soft);
        border: 1px solid #fbe0b8;
        border-radius: 14px;
        text-decoration: none;
        color: #7c2d12;
        font-size: 0.92rem;
        position: relative;
        z-index: 1;
    }

    .fk-profile:hover { border-color: var(--fk-orange); }
    .fk-profile-bar { flex: none; width: 90px; height: 8px; border-radius: 999px; background: #fff; overflow: hidden; }
    .fk-profile-bar span { display: block; height: 100%; background: var(--fk-orange); border-radius: 999px; }
    .fk-profile-text b { color: #b06410; }

    /* روابط سريعة (المرحلة 5) */
    .fk-quick {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 12px;
        margin-bottom: 14px;
    }

    .fk-quick-item {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #fff;
        border: 1px solid #e6efe6;
        border-radius: 16px;
        padding: 14px 16px;
        text-decoration: none;
        color: var(--fk-ink);
    }

    .fk-quick-item:hover { border-color: var(--fk-leaf); }
    .fk-quick-item > i { font-size: 1.5rem; color: var(--fk-green); }
    .fk-quick-item span { display: flex; flex-direction: column; }
    .fk-quick-item small { color: #6b7d6d; font-size: 0.78rem; }
    .fk-quick-celebrate { background: var(--fk-orange-soft); border-color: #fbe0b8; }
    .fk-quick-celebrate > i { color: var(--fk-orange); }

    /* رابط الدعوة (5-3) */
    .fk-invite {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        background: #fff;
        border: 1px solid #e6efe6;
        border-radius: 16px;
        padding: 14px 16px;
        margin-bottom: 30px;
    }

    .fk-invite-text { flex: 1 1 260px; display: flex; flex-direction: column; }
    .fk-invite-text b { color: var(--fk-green); }
    .fk-invite-text small { color: #6b7d6d; font-size: 0.8rem; }
    .fk-invite-text a { color: var(--fk-orange); font-weight: 700; text-decoration: none; }
    .fk-invite-link { display: flex; gap: 6px; flex: 1 1 320px; }
    .fk-invite-link input { flex: 1; min-width: 0; border: 1.5px solid #d9e6d9; border-radius: 10px; padding: 8px 12px; font-size: 0.82rem; direction: ltr; color: #4a5f4c; }
    .fk-invite-link button { background: var(--fk-green); color: #fff; border: none; border-radius: 10px; padding: 8px 14px; font-weight: 700; white-space: nowrap; }
    .fk-invite-wa { display: inline-flex; align-items: center; justify-content: center; width: 40px; border-radius: 10px; background: #25D366; color: #fff; font-size: 1.2rem; text-decoration: none; }

    /* شارات الإنجاز (4-2) */
    .fk-badges {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 12px;
        margin-bottom: 30px;
    }

    .fk-badge {
        background: #fff;
        border: 1px solid #e6efe6;
        border-radius: 16px;
        padding: 14px 12px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
    }

    .fk-badge-ico {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
    }

    .fk-badge.earned .fk-badge-ico { background: var(--fk-orange); color: #fff; box-shadow: 0 6px 14px rgba(250, 156, 40, 0.35); }
    .fk-badge.earned { border-color: var(--fk-leaf); }
    .fk-badge.locked .fk-badge-ico { background: #f1f5f1; color: #a3b1a5; }
    .fk-badge.locked .fk-badge-title { color: #7a8c7c; }
    .fk-badge-title { font-weight: 700; font-size: 0.88rem; color: var(--fk-green); }
    .fk-badge-hint { font-size: 0.75rem; color: #8a9a8c; }
    .fk-badge-prog { width: 70%; height: 5px; border-radius: 999px; background: #eef3ee; overflow: hidden; }
    .fk-badge-prog span { display: block; height: 100%; background: var(--fk-leaf); }

    /* "N جديدة منذ زيارتك" (4-1) */
    .fk-new-count {
        background: var(--fk-orange-soft);
        color: #b06410;
        border-radius: 999px;
        padding: 4px 12px;
        font-size: 0.82rem;
        font-weight: 700;
    }

    /* تابعت مؤخرًا */
    .fk-recent {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin: -10px 0 30px;
    }

    .fk-recent-title { color: #5c715e; font-weight: 600; font-size: 0.9rem; }
    .fk-recent a.fk-chip { text-decoration: none; }
    .fk-recent a.fk-chip:hover { background: var(--fk-leaf-soft); }

    /* بطاقة محفوظة مع شريط التتبّع أسفلها */
    .fk-saved-card {
        height: 100%;
        display: flex;
        flex-direction: column;
        background: #fff;
        border-radius: 20px;
        border: 1px solid #e6efe6;
        overflow: hidden;
    }

    .fk-saved-card .opp-card { border: none; border-radius: 0; flex: 1; }
    .fk-saved-card .opp-card:hover { transform: none; box-shadow: none; }
    .fk-saved-card:hover { box-shadow: 0 16px 30px rgba(27, 107, 35, 0.1); border-color: var(--fk-leaf); }

    /* ===== الصناديق الفارغة ===== */
    .fk-empty {
        background: #fff;
        border: 1.5px dashed var(--fk-leaf);
        border-radius: 18px;
        text-align: center;
        padding: 38px 16px;
        color: #5c715e;
    }

    .fk-empty .fk-leaves { margin-bottom: 10px; }

    .fk-empty a {
        color: var(--fk-green);
        font-weight: 700;
    }

    /* ===== ضبط بطاقات الفرص على الهوية داخل الصفحة ===== */
    .fk-dash .opp-card {
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid #e6efe6;
        transition: all 0.25s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        font-family: var(--fk-font-body);
    }

    .fk-dash .opp-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 30px rgba(27, 107, 35, 0.1);
        border-color: var(--fk-leaf);
    }

    .fk-dash .opp-image { width: 100%; height: 200px; object-fit: cover; }

    .fk-dash .opp-category-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 16px 18px 0;
    }

    .fk-dash .type-tag,
    .fk-dash .category-tag {
        display: inline-flex;
        align-items: center;
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .fk-dash .type-tag { background: var(--fk-green-soft); color: var(--fk-green); }
    .fk-dash .category-tag { background: var(--fk-sky-soft); color: #1a7f9c; }

    .fk-dash .opp-title {
        padding: 14px 18px 0;
        font-size: 1.08rem;
        font-weight: 700;
        color: var(--fk-ink);
        line-height: 1.65;
        margin: 0;
        flex: 1;
    }

    .fk-dash .opp-status {
        display: inline-flex;
        margin: 14px 18px 0;
        padding: 7px 14px;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 700;
        align-self: flex-start;
    }

    .fk-dash .status-available { background: var(--fk-leaf-soft); color: var(--fk-green); }
    .fk-dash .status-expired { background: #fff1f2; color: #dc2626; }
    .fk-dash .status-soon { background: var(--fk-orange-soft); color: #b06410; }

    .fk-dash .opp-info-row {
        padding: 18px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .fk-dash .opp-info-row .btn-details { flex: 1; }

    @@media (max-width: 576px) {
        .fk-hero { padding: 26px 20px; }
        .fk-hero h1 { font-size: 1.55rem; }
        .fk-divider .bar:first-child { width: 90px; }
    }
</style>

@{
    // ورقتا الشعار (SVG مضمّن بألوان الهوية) — تُستخدم بجانب العناوين
    Func<int, Microsoft.AspNetCore.Html.HtmlString> Leaves = size => new Microsoft.AspNetCore.Html.HtmlString(
        $"<svg class=\"fk-leaves\" width=\"{size}\" height=\"{(int)(size * 0.72)}\" viewBox=\"0 0 50 36\" fill=\"none\" aria-hidden=\"true\">" +
        "<path d=\"M24 34C23 21 14 11 3 10c1 13 10 23 21 24Z\" fill=\"#ABE188\"/>" +
        "<path d=\"M26 34C27 18 37 5 48 3c-1 16-11 29-22 31Z\" fill=\"#1B6B23\"/></svg>");
}

<div class="page-wrapper container fk-dash">

    @* ===== الترويسة ===== *@
    <section class="fk-hero">
        <h1>@T("أهلًا بعودتك، ", "Welcome back, ", "Bon retour, ")<span class="hl">@Model.FirstName</span></h1>
        <p class="sub">@T("فرصك المحفوظة، واقتراحات على ذوقك، وكل جديد — في مكان واحد.",
                         "Your saved opportunities, picks to your taste, and everything new — in one place.",
                         "Vos opportunités enregistrées, des suggestions à votre goût et toutes les nouveautés — au même endroit.")</p>
        <div class="fk-divider" aria-hidden="true">
            <span class="bar"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="bar"></span>
        </div>
        <span class="tag">#@T("من_وإلى_الشباب_العربي", "from_and_to_Arabian_youth", "de_et_pour_la_jeunesse_arabe")</span>

        @* اكتمال الملف (4-4) — يختفي عند 100% *@
        @if (!Model.Profile.IsComplete)
        {
            <a class="fk-profile" href="@Url.Action("ProfileSettings", "Account")">
                <span class="fk-profile-bar"><span style="width:@Model.Profile.Percent%"></span></span>
                <span class="fk-profile-text">
                    <b>@T($"ملفك {Model.Profile.Percent}%", $"Your profile is {Model.Profile.Percent}% complete", $"Votre profil est complet à {Model.Profile.Percent} %")</b>
                    — @ProfileCompletion.Prompt(Model.Profile.NextKey!, lang)
                    <i class="bi bi-arrow-left-short"></i>
                </span>
            </a>
        }
    </section>

    @* ===== روابط سريعة: ملخص الأسبوع، خزانة الأعضاء، بطاقة الإنجاز (المرحلة 5) ===== *@
    <div class="fk-quick">
        <a class="fk-quick-item" href="@Url.Action("Weekly", "User")">
            <i class="bi bi-calendar-week"></i>
            <span><b>@T("ملخص أسبوعك", "Your weekly summary", "Votre résumé hebdo")</b><small>@T("ما جدّ خلال 7 أيام في اهتماماتك ومحفوظاتك", "What's new in 7 days across your interests and saves", "Les nouveautés de la semaine")</small></span>
        </a>
        <a class="fk-quick-item" href="@Url.Action("Vault", "Resources")">
            <i class="bi bi-safe2"></i>
            <span><b>@T("خزانة الأعضاء", "Members' vault", "Coffre des membres")</b><small>@T("قوالب سيرة وخطابات دوافع وأدلة — للمسجلين فقط", "CV templates, motivation letters and guides — members only", "Modèles de CV, lettres et guides — réservés aux membres")</small></span>
        </a>
        @if (Model.LatestAccepted != null)
        {
            <a class="fk-quick-item fk-quick-celebrate" href="@Url.Action("ShareCard", "Tracker", new { id = Model.LatestAccepted.Id })">
                <i class="bi bi-stars"></i>
                <span><b>@T("شارك إنجازك 🎉", "Share your achievement 🎉", "Partagez votre réussite 🎉")</b><small>@T("بطاقة بهوية فرص خضراء لستوري إنستغرام", "A Foras Khadra card for your Instagram story", "Une carte Foras Khadra pour votre story")</small></span>
            </a>
        }
    </div>

    @* ===== رابط الدعوة (5-3) ===== *@
    @{
        var inviteUrl = Url.Action("RegisterUser", "Account", new { @ref = Model.ReferralCode }, Context.Request.Scheme);
    }
    <div class="fk-invite">
        <div class="fk-invite-text">
            <b><i class="bi bi-megaphone"></i> @T("ادعُ أصدقاءك إلى فرص خضراء", "Invite your friends to Foras Khadra", "Invitez vos amis sur Foras Khadra")</b>
            <small>
                @T($"دعواتك حتى الآن: {Model.ReferralCount}", $"Your invites so far: {Model.ReferralCount}", $"Vos invitations : {Model.ReferralCount}")
                · @T("3 دعوات = شارة السفير", "3 invites = Ambassador badge", "3 invitations = badge Ambassadeur")
                · <a href="@Url.Action("Ambassadors", "Home")">@T("سفراء الشهر", "This month's ambassadors", "Ambassadeurs du mois")</a>
            </small>
        </div>
        <div class="fk-invite-link">
            <input type="text" readonly value="@inviteUrl" id="inviteUrl" aria-label="@T("رابط الدعوة", "Invite link", "Lien d'invitation")" />
            <button type="button" onclick="fkCopyInvite(this)" data-copied="@T("نُسخ ✓", "Copied ✓", "Copié ✓")">
                <i class="bi bi-clipboard"></i> @T("نسخ", "Copy", "Copier")
            </button>
            <a class="fk-invite-wa" target="_blank" rel="noopener"
               href="https://wa.me/?text=@Uri.EscapeDataString(T("انضم إليّ في فرص خضراء — منصة الفرص والمنح للشباب العربي: ", "Join me on Foras Khadra — opportunities and scholarships for Arab youth: ", "Rejoins-moi sur Foras Khadra — opportunités et bourses pour la jeunesse arabe : ") + inviteUrl)">
                <i class="bi bi-whatsapp"></i>
            </a>
        </div>
    </div>
    <script>
        function fkCopyInvite(btn) {
            var input = document.getElementById('inviteUrl');
            navigator.clipboard.writeText(input.value).then(function () {
                var old = btn.innerHTML; btn.textContent = btn.getAttribute('data-copied');
                setTimeout(function () { btn.innerHTML = old; }, 1800);
            });
        }
    </script>

    @* ===== شارات الإنجاز (4-2) ===== *@
    <div class="fk-badges">
        @foreach (var a in Model.Achievements)
        {
            <div class="fk-badge @(a.Earned ? "earned" : "locked")" title="@(a.Earned ? Achievements.Title(a.Key, lang) : Achievements.Hint(a.Key, lang))">
                <span class="fk-badge-ico"><i class="bi @a.Icon"></i></span>
                <span class="fk-badge-title">@Achievements.Title(a.Key, lang)</span>
                @if (!a.Earned)
                {
                    <span class="fk-badge-hint">@Achievements.Hint(a.Key, lang)</span>
                    <span class="fk-badge-prog"><span style="width:@a.Percent%"></span></span>
                }
            </div>
        }
    </div>

    @* ===== الأرقام ===== *@
    <div class="fk-stats">
        <div class="fk-stat saved">
            <i class="bi bi-bookmark-fill"></i>
            <div><strong>@Model.SavedCount</strong><span>@T("فرصة محفوظة", "saved opportunities", "opportunités enregistrées")</span></div>
        </div>
        @if (Model.ExpiringSaved.Any())
        {
            <div class="fk-stat expiring">
                <i class="bi bi-alarm"></i>
                <div><strong>@Model.ExpiringSaved.Count</strong><span>@T("تنتهي قريبًا", "closing soon", "bientôt clôturées")</span></div>
            </div>
        }
        @if (Model.AppliedCount > 0)
        {
            <div class="fk-stat picked">
                <i class="bi bi-send-check"></i>
                <div><strong>@Model.AppliedCount</strong><span>@T("قدّمت عليها", "applied", "candidatures envoyées")</span></div>
            </div>
        }
        @if (Model.AcceptedCount > 0)
        {
            <div class="fk-stat saved">
                <i class="bi bi-trophy"></i>
                <div><strong>@Model.AcceptedCount</strong><span>@T("قُبلت 🎉", "accepted 🎉", "acceptées 🎉")</span></div>
            </div>
        }
        @if (Model.Recommended.Any() && Model.AppliedCount == 0)
        {
            <div class="fk-stat picked">
                <i class="bi bi-stars"></i>
                <div><strong>@Model.Recommended.Count</strong><span>@T("مقترحة لك", "picked for you", "suggérées pour vous")</span></div>
            </div>
        }
    </div>

    @* ===== تابعت مؤخرًا ===== *@
    @if (Model.Recent.Any())
    {
        <div class="fk-recent">
            <span class="fk-recent-title"><i class="bi bi-clock-history"></i> @T("تابعت مؤخرًا:", "Recently viewed:", "Vus récemment :")</span>
            @foreach (var opp in Model.Recent)
            {
                var rTitle = lang switch { "en" => opp.TitleEn, "fr" => opp.TitleFr, _ => opp.TitleAr };
                <a class="fk-chip" href="@Url.Action("Details", "Opportunity", new { id = opp.Id, slug = SlugHelper.Make(rTitle) })">@rTitle</a>
            }
        </div>
    }

    @* ===== محفوظات تنتهي قريبًا ===== *@
    @if (Model.ExpiringSaved.Any())
    {
        <div class="fk-expiring">
            <div class="fk-expiring-title">
                <i class="bi bi-alarm"></i>
                @T("من محفوظاتك: مواعيد تقترب", "From your saved list: deadlines approaching", "Dans vos enregistrements : échéances proches")
            </div>
            <ul>
                @foreach (var opp in Model.ExpiringSaved)
                {
                    var title = lang switch { "en" => opp.TitleEn, "fr" => opp.TitleFr, _ => opp.TitleAr };
                    var daysLeft = (opp.EndDate!.Value.Date - DateTime.Now.Date).Days;
                    var daysText = daysLeft == 0
                        ? T("ينتهي اليوم", "ends today", "se termine aujourd'hui")
                        : daysLeft == 1
                            ? T("يبقى يوم واحد", "1 day left", "1 jour restant")
                            : T($"تبقى {daysLeft} أيام", $"{daysLeft} days left", $"{daysLeft} jours restants");
                    <li>
                        <a href="@Url.Action("Details", "Opportunity", new { id = opp.Id, slug = SlugHelper.Make(title) })">@title</a>
                        <span class="days-left">— @daysText</span>
                    </li>
                }
            </ul>
        </div>
    }

    @* ===== مقترحة لك ===== *@
    <section class="fk-section">
        <div class="fk-section-head">
            @Leaves(34)
            <h2>@T("مقترحة لك", "Picked for you", "Suggérées pour vous")</h2>
        </div>

        @if (Model.InterestNames.Any())
        {
            <p class="fk-section-sub">
                @if (Model.MatchesNationality)
                {
                    @T("بحسب اهتماماتك، ومن الفرص التي تقبل جنسيتك أو بلدك:", "Based on your interests, among opportunities open to your nationality or country:", "Selon vos intérêts, parmi les opportunités ouvertes à votre nationalité ou pays :")
                }
                else
                {
                    @T("بحسب الاهتمامات التي اخترتها:", "Based on the interests you chose:", "Selon les intérêts que vous avez choisis :")
                    <a href="@Url.Action("ProfileSettings", "Account")" style="color:var(--fk-orange); font-weight:700; text-decoration:none;">@T("أضف جنسيتك لنرشّح فرصًا تقبلها", "Add your nationality to get eligible picks", "Ajoutez votre nationalité pour des suggestions éligibles")</a>
                }
            </p>
            <div class="fk-chips">
                @foreach (var name in Model.InterestNames)
                {
                    <span class="fk-chip">@name</span>
                }
                <a class="edit" href="@Url.Action("ProfileSettings", "Account")">
                    <i class="bi bi-pencil"></i> @T("تعديل اهتماماتي", "Edit my interests", "Modifier mes intérêts")
                </a>
            </div>
        }

        @if (!Model.InterestNames.Any())
        {
            <div class="fk-empty">
                @Leaves(44)
                <p>
                    @T("أخبرنا باهتماماتك لنقترح لك فرصًا تناسبك.", "Tell us your interests and we'll suggest opportunities for you.", "Indiquez vos intérêts et nous vous suggérerons des opportunités.")
                </p>
                <a href="@Url.Action("ProfileSettings", "Account")">@T("اختر اهتماماتك", "Choose your interests", "Choisir vos intérêts")</a>
            </div>
        }
        else if (!Model.Recommended.Any())
        {
            <div class="fk-empty">
                @Leaves(44)
                <p>
                    @T("لا فرص مفتوحة تطابق اهتماماتك الآن — نضيف فرصًا جديدة باستمرار.", "No open opportunities match your interests right now — we add new ones all the time.", "Aucune opportunité ouverte ne correspond à vos intérêts pour le moment — nous en ajoutons régulièrement.")
                </p>
                <a href="@Url.Action("AllOpportunities", "Home")">@T("تصفّح كل الفرص", "Browse all opportunities", "Parcourir toutes les opportunités")</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var opp in Model.Recommended)
                {
                    <div class="col-lg-4 col-md-6">
                        @await Html.PartialAsync("_OpportunityCard", (opp, Model.SavedIds.Contains(opp.Id)))
                    </div>
                }
            </div>
        }
    </section>

    @* ===== بحوثك المحفوظة ===== *@
    @if (Model.SavedSearches.Any())
    {
        <section class="fk-section">
            <div class="fk-section-head">
                @Leaves(34)
                <h2>@T("بحوثك المحفوظة", "Your saved searches", "Vos recherches enregistrées")</h2>
            </div>
            <p class="fk-section-sub">@T("نعلمك في الجرس بكل فرصة جديدة تطابق أيًّا منها.", "We alert you in the bell about every new match.", "Nous vous alertons de chaque nouvelle correspondance.")</p>
            <div class="fk-chips">
                @foreach (var s in Model.SavedSearches)
                {
                    var label = Foras_Khadra.Services.NotificationSweeper.BuildLabel(s);
                    var linkParams = Foras_Khadra.Services.NotificationSweeper.BuildLinkParams(s);
                    var runUrl = Url.Action("AllOpportunities", "Home") + (linkParams.Length > 0 ? "?" + linkParams : "");
                    <span class="fk-chip" style="display:inline-flex; align-items:center; gap:8px;">
                        <a href="@runUrl" style="color:inherit; text-decoration:none;"><i class="bi bi-search"></i> @label</a>
                        <form method="post" asp-controller="SavedSearch" asp-action="Delete" asp-route-id="@s.Id" style="display:inline;">
                            <button type="submit" style="border:none; background:none; color:#b06410; padding:0; cursor:pointer;"
                                    title="@T("حذف", "Delete", "Supprimer")" aria-label="@T("حذف هذا البحث", "Delete this search", "Supprimer cette recherche")">
                                <i class="bi bi-x-circle"></i>
                            </button>
                        </form>
                    </span>
                }
            </div>
        </section>
    }

    @* ===== محفوظاتك ===== *@
    <section class="fk-section">
        <div class="fk-section-head">
            @Leaves(34)
            <h2>@T("محفوظاتك", "Your saved opportunities", "Vos opportunités enregistrées")</h2>
            @if (Model.SavedCount > 0)
            {
                <a class="view-all" href="@Url.Action("Saved", "Opportunity")">
                    @T($"عرض الكل ({Model.SavedCount})", $"View all ({Model.SavedCount})", $"Tout voir ({Model.SavedCount})")
                </a>
            }
        </div>

        @if (!Model.Saved.Any())
        {
            <div class="fk-empty">
                @Leaves(44)
                <p>
                    @T("لم تحفظ أي فرصة بعد — اضغط رمز الحفظ على أي بطاقة لتعود إليها هنا.", "You haven't saved any opportunity yet — tap the bookmark icon on any card to find it here.", "Vous n'avez encore rien enregistré — touchez l'icône signet d'une carte pour la retrouver ici.")
                </p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var opp in Model.Saved)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="fk-saved-card">
                            @await Html.PartialAsync("_OpportunityCard", (opp, true))
                            @if (Model.Tracker.TryGetValue(opp.Id, out var card))
                            {
                                @await Html.PartialAsync("_ApplicationTracker", card)
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    @* ===== أحدث الفرص ===== *@
    @if (Model.Latest.Any())
    {
        <section class="fk-section">
            <div class="fk-section-head">
                @Leaves(34)
                <h2>@T("أحدث الفرص", "Latest opportunities", "Dernières opportunités")</h2>
                @if (Model.NewSinceCount > 0)
                {
                    <span class="fk-new-count">
                        <i class="bi bi-sparkles"></i>
                        @T($"{Model.NewSinceCount} جديدة منذ زيارتك الأخيرة", $"{Model.NewSinceCount} new since your last visit", $"{Model.NewSinceCount} nouvelles depuis votre dernière visite")
                    </span>
                }
                <a class="view-all" href="@Url.Action("AllOpportunities", "Home")">
                    @T("عرض الكل", "View all", "Tout voir")
                </a>
            </div>
            <div class="row g-4">
                @foreach (var opp in Model.Latest)
                {
                    <div class="col-lg-4 col-md-6">
                        @await Html.PartialAsync("_OpportunityCard", (opp, Model.SavedIds.Contains(opp.Id)))
                    </div>
                }
            </div>
        </section>
    }
</div>
