@model Foras_Khadra.Models.SavedOpportunity
@using Foras_Khadra.Helpers
@using Foras_Khadra.Models
@{
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    string T(string ar, string en, string fr) => lang == "en" ? en : lang == "fr" ? fr : ar;

    var opp = Model.Opportunity!;
    var title = lang switch { "en" => opp.TitleEn, "fr" => opp.TitleFr, _ => opp.TitleAr };
    var pageTitle = T("رفيق التقديم", "Application companion", "Compagnon de candidature");
    ViewData["Title"] = pageTitle + " — " + title;
    ViewData["Description"] = pageTitle;

    var items = Model.Checklist.OrderBy(c => c.SortOrder).ThenBy(c => c.Id).ToList();
    var done = Model.Status.HasApplied() ? items.Count : items.Count(c => c.Done);
    var percent = Model.Status.HasApplied() ? 100 : items.Count == 0 ? 0 : done * 100 / items.Count;

    int? daysLeft = opp.DeadlineType == DeadlineType.SpecificDate && opp.EndDate.HasValue
        ? (opp.EndDate.Value.Date - DateTime.Now.Date).Days : null;
    var returnUrl = Context.Request.Path.ToString();
}

<style>
    body { background: var(--fk-bg); }
    .prep { font-family: var(--fk-font-body); color: var(--fk-ink); max-width: 760px; }

    .prep-head {
        background: #fff;
        border: 1px solid #e6efe6;
        border-radius: 22px;
        padding: 26px 28px;
        margin: 26px 0 20px;
    }

    .prep-head .eyebrow { color: var(--fk-orange); font-weight: 700; font-size: 0.9rem; margin-bottom: 4px; }
    .prep-head h1 { font-family: var(--fk-font-head); color: var(--fk-green); font-size: 1.6rem; margin: 0 0 10px; }
    .prep-head .meta { color: #5c715e; font-size: 0.92rem; display: flex; gap: 14px; flex-wrap: wrap; }
    .prep-head .meta .soon { color: #b06410; font-weight: 700; }

    .prep-progress { margin-top: 18px; }
    .prep-progress .bar { height: 12px; background: var(--fk-green-soft); border-radius: 999px; overflow: hidden; }
    .prep-progress .bar span { display: block; height: 100%; background: linear-gradient(90deg, var(--fk-leaf), var(--fk-green)); border-radius: 999px; transition: width .3s; }
    .prep-progress .pct { font-family: var(--fk-font-head); color: var(--fk-green); font-size: 1.15rem; margin-top: 8px; }

    .prep-status { display: flex; align-items: center; gap: 10px; margin-top: 16px; flex-wrap: wrap; }
    .prep-status select { border: 1.5px solid var(--fk-leaf); border-radius: 999px; padding: 6px 14px; font-weight: 600; color: var(--fk-green); background: #fff; }

    .prep-list { background: #fff; border: 1px solid #e6efe6; border-radius: 22px; padding: 10px 14px; }
    .prep-item { display: flex; align-items: center; gap: 12px; padding: 12px 8px; border-bottom: 1px solid #f0f4f0; }
    .prep-item:last-child { border-bottom: none; }
    .prep-item form { display: contents; }
    .prep-item .check {
        width: 26px; height: 26px; border-radius: 8px; border: 2px solid var(--fk-leaf);
        background: #fff; color: #fff; display: inline-flex; align-items: center; justify-content: center;
        cursor: pointer; flex: none; font-size: 0.9rem;
    }
    .prep-item.done .check { background: var(--fk-green); border-color: var(--fk-green); }
    .prep-item .label { flex: 1; font-weight: 600; }
    .prep-item.done .label { color: #7a8c7c; text-decoration: line-through; }
    .prep-item .remove { border: none; background: none; color: #b06410; cursor: pointer; padding: 4px; }

    .prep-add { display: flex; gap: 10px; margin-top: 14px; }
    .prep-add input { flex: 1; border: 1.5px solid #d9e6d9; border-radius: 12px; padding: 10px 14px; }
    .prep-add button { background: var(--fk-orange); color: #fff; border: none; border-radius: 12px; padding: 10px 18px; font-weight: 700; }

    .prep-links { margin-top: 20px; display: flex; gap: 16px; flex-wrap: wrap; }
    .prep-links a { color: var(--fk-green); font-weight: 700; text-decoration: none; }
    .prep-links a:hover { text-decoration: underline; }
</style>

<div class="page-wrapper container prep">
    <header class="prep-head">
        <div class="eyebrow"><i class="bi bi-clipboard-check"></i> @pageTitle</div>
        <h1>@title</h1>
        <div class="meta">
            <span><i class="bi bi-tag"></i> @opp.Type.GetDisplayName(lang)</span>
            @if (daysLeft.HasValue)
            {
                <span class="@(daysLeft <= 7 ? "soon" : "")">
                    <i class="bi bi-alarm"></i>
                    @(daysLeft < 0 ? T("انتهى الموعد", "Deadline passed", "Date limite dépassée")
                        : daysLeft == 0 ? T("ينتهي اليوم", "Ends today", "Se termine aujourd'hui")
                        : T($"تبقى {daysLeft} أيام", $"{daysLeft} days left", $"{daysLeft} jours restants"))
                </span>
            }
        </div>

        <div class="prep-progress">
            <div class="bar"><span style="width:@percent%"></span></div>
            <div class="pct">
                @T($"ملفك جاهز {percent}%", $"Your file is {percent}% ready", $"Votre dossier est prêt à {percent} %")
                @if (percent == 100)
                {
                    <span>🎉</span>
                }
            </div>
        </div>

        <form method="post" asp-controller="Tracker" asp-action="SetStatus" asp-route-id="@opp.Id" class="prep-status">
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <label for="prepStatus" style="font-weight:600;">@T("حالة التقديم:", "Application status:", "Statut de candidature :")</label>
            <select id="prepStatus" name="status" onchange="this.form.submit()">
                @foreach (ApplicationStatus s in Enum.GetValues<ApplicationStatus>())
                {
                    <option value="@s" selected="@(s == Model.Status)">@s.Label(lang)</option>
                }
            </select>
        </form>
    </header>

    <div class="prep-list">
        @foreach (var item in items)
        {
            var label = item.Key != null ? ChecklistDefaults.Label(item.Key, lang) : item.Text;
            var isDone = Model.Status.HasApplied() || item.Done;
            <div class="prep-item @(isDone ? "done" : "")">
                <form method="post" asp-controller="Tracker" asp-action="ToggleItem" asp-route-id="@opp.Id">
                    <input type="hidden" name="itemId" value="@item.Id" />
                    <button type="submit" class="check" aria-pressed="@(isDone ? "true" : "false")"
                            aria-label="@label">@(isDone ? "✓" : "")</button>
                </form>
                <span class="label">@label</span>
                <form method="post" asp-controller="Tracker" asp-action="RemoveItem" asp-route-id="@opp.Id">
                    <input type="hidden" name="itemId" value="@item.Id" />
                    <button type="submit" class="remove" title="@T("حذف", "Remove", "Supprimer")" aria-label="@T("حذف البند", "Remove item", "Supprimer l'élément")">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </form>
            </div>
        }
        @if (!items.Any())
        {
            <p class="text-muted m-0 p-2">@T("لا بنود بعد — أضف أول بند لملفك.", "No items yet — add the first one.", "Aucun élément — ajoutez le premier.")</p>
        }
    </div>

    @if (items.Count < Foras_Khadra.Services.ApplicationTracker.MaxChecklistItems)
    {
        <form method="post" asp-controller="Tracker" asp-action="AddItem" asp-route-id="@opp.Id" class="prep-add">
            <input type="text" name="text" maxlength="120" required
                   placeholder="@T("أضف بندًا خاصًا بك، مثل: ترجمة الشهادة", "Add your own item, e.g. translate the certificate", "Ajouter un élément, ex. : traduire le diplôme")" />
            <button type="submit"><i class="bi bi-plus-lg"></i> @T("أضف", "Add", "Ajouter")</button>
        </form>
    }

    <div class="prep-links">
        <a href="@Url.Action("Details", "Opportunity", new { id = opp.Id, slug = SlugHelper.Make(title) })"><i class="bi bi-box-arrow-up-right"></i> @T("صفحة الفرصة", "Opportunity page", "Page de l'opportunité")</a>
        <a href="@Url.Action("Dashboard", "User")"><i class="bi bi-house"></i> @T("العودة إلى صفحتي", "Back to My page", "Retour à Ma page")</a>
    </div>
</div>
