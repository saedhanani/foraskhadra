@* نتيجة الزائر: العدد الكامل، ثلاث بطاقات ظاهرة، والباقي مغبَّش خلف بوابة التسجيل (returnUrl يعيده إلى بوصلته) *@
@model Foras_Khadra.Models.CompassResultVM
@using Foras_Khadra.Models
@{
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var dir = lang == "ar" ? "rtl" : "ltr";
    string T(string ar, string en, string fr) => lang == "en" ? en : lang == "fr" ? fr : ar;
    var r = Model.Result;
    ViewData["Title"] = T($"وجدنا لك {r.NowCount} فرصة تناسبك الآن", $"We found {r.NowCount} opportunities that fit you now", $"Nous avons trouvé {r.NowCount} opportunités pour vous");
    var soonText = r.SoonWithin3Months > 0 ? T($"، و{r.SoonWithin3Months} برامج تفتح خلال 3 أشهر", $", and {r.SoonWithin3Months} programs opening within 3 months", $", et {r.SoonWithin3Months} programmes qui s'ouvrent sous 3 mois") : "";
    ViewData["Description"] = T("نتيجة بوصلتك: الفرص المؤهَّل لها الآن وما سيُفتح قريبًا.", "Your compass result: what you qualify for now and what opens soon.", "Votre résultat : ce à quoi vous êtes éligible maintenant et ce qui s'ouvre bientôt.");
    var visible = r.Now.Take(CompassResultVM.VisibleCards).ToList();
    var locked = r.Now.Skip(CompassResultVM.VisibleCards).Take(6).ToList();
    var registerUrl = Url.Action("Register", "Compass");
    var loginUrl = Url.Action("Login", "Account", new { returnUrl = Url.Action("Me", "Compass") });
}
<meta name="robots" content="noindex" />
<link asp-append-version="true" rel="stylesheet" href="~/css/compass.css" />

<div class="cp-page" dir="@dir">
    <section class="cp-hero">
        <span class="cp-kicker"><i class="bi bi-compass"></i> @T("نتيجة بوصلتك", "Your compass result", "Votre boussole")</span>
        @if (r.ConfirmedCount > 0)
        {
            <h1>@T("أنت مؤهَّل الآن لـ", "You qualify right now for ", "Vous êtes éligible maintenant à ")<b>@r.ConfirmedCount</b> @T("فرصة", "opportunities", "opportunités")@(r.LikelyCount > 0 ? T($"، و{r.LikelyCount} أخرى تناسبك وتحتاج مراجعة شروطها", $", and {r.LikelyCount} more fit you but need a requirements check", $", et {r.LikelyCount} autres vous correspondent mais demandent une vérification") : "")@soonText.</h1>
        }
        else if (r.LikelyCount > 0)
        {
            <h1>@T("وجدنا لك", "We found", "Nous avons trouvé") <b>@r.LikelyCount</b> @T("فرصة تناسبك — راجع شروطها قبل التقديم", "opportunities that fit you — check their requirements before applying", "opportunités qui vous correspondent — vérifiez leurs conditions avant de postuler")@soonText.</h1>
        }
        else
        {
            <h1>@T("لا فرصة مطابقة تمامًا الآن", "No exact match right now", "Pas de correspondance exacte pour le moment")@(r.PartialCount > 0 ? T($"، لكن {r.PartialCount} ينقصها شرط واحد فقط", $", but {r.PartialCount} are one requirement away", $", mais {r.PartialCount} ne sont qu'à une condition près") : "").</h1>
        }
        <p>@T("فحصنا الدولة والمرحلة والعمر والمجال واللغة والتمويل. كل بطاقة تشرح لماذا تناسبك وما لم نتحقق منه.", "We checked country, level, age, field, language and funding. Each card explains why it fits you and what we could not verify.", "Nous avons vérifié le pays, le niveau, l'âge, le domaine, la langue et le financement. Chaque carte explique pourquoi elle vous convient et ce que nous n'avons pas pu vérifier.")</p>
        <div class="cp-stats">
            <div class="cp-stat"><b>@r.ConfirmedCount</b><span>@T("أهلية مؤكَّدة", "confirmed", "confirmées")</span></div>
            <div class="cp-stat"><b>@r.LikelyCount</b><span>@T("تحتاج مراجعة", "to check", "à vérifier")</span></div>
            <div class="cp-stat"><b>@r.PartialCount</b><span>@T("ينقصها شرط", "one requirement away", "à une condition près")</span></div>
            <div class="cp-stat"><b>@r.Soon.Count</b><span>@T("تفتح قريبًا", "opening soon", "bientôt ouvertes")</span></div>
        </div>
        <p class="cp-legend">@Html.Raw(T(
            "<b>مؤكَّدة:</b> كل شرط نعرفه عن الفرصة طابق إجاباتك. <b>تحتاج مراجعة:</b> تناسبك، لكن شرطًا لم يُذكر في بياناتنا أو لم تُجب عنه. القرار النهائي للجهة المانحة.",
            "<b>Confirmed:</b> every requirement we know matches your answers. <b>To check:</b> it fits you, but a requirement is missing from our data or from your answers. The provider has the final say.",
            "<b>Confirmées :</b> chaque condition connue correspond à vos réponses. <b>À vérifier :</b> elle vous correspond, mais une condition manque dans nos données ou vos réponses. La décision finale revient à l'organisme."))</p>
        <div class="cp-actions">
            <a class="cp-btn cp-btn--orange" href="@registerUrl"><i class="bi bi-unlock"></i> @T("أنشئ حسابًا مجانيًا لفتح كل النتائج", "Create a free account to unlock all results", "Créez un compte gratuit pour tout débloquer")</a>
            <a class="cp-btn cp-btn--ghost" href="@Url.Action("Index", "Compass", new { edit = true })"><i class="bi bi-pencil"></i> @T("عدّل إجاباتك", "Edit answers", "Modifier")</a>
        </div>
    </section>

    @if (visible.Count > 0)
    {
        <section class="cp-section">
            <h2><i class="bi bi-lightning-charge"></i> @T("الآن", "Now", "Maintenant")</h2>
            <p class="sub">@T("المؤكَّدة أولًا ثم بدرجة التطابق. ثلاثة أسباب لكل فرصة، وما ينقصك أو ما يحتاج مراجعة.", "Confirmed first, then by match. Three reasons per opportunity, plus what is missing or needs checking.", "Les confirmées d'abord, puis par correspondance. Trois raisons par opportunité, et ce qui manque ou reste à vérifier.")</p>
            <div class="cp-cards">
                @foreach (var m in visible) { @await Html.PartialAsync("_CompassCard", m) }
            </div>
        </section>
    }

    @if (locked.Count > 0 || r.Soon.Count > 0)
    {
        <section class="cp-section cp-locked">
            <div class="cp-cards" aria-hidden="true">
                @foreach (var m in locked) { @await Html.PartialAsync("_CompassCard", m) }
            </div>
            <div class="cp-gate">
                <div class="cp-gate__box">
                    <h3>@T($"و{Math.Max(0, r.NowCount - visible.Count(v => v.Eligible))} فرصة أخرى، و{r.Soon.Count} برامج تفتح قريبًا، وقائمة أوراقك", $"{Math.Max(0, r.NowCount - visible.Count(v => v.Eligible))} more opportunities, {r.Soon.Count} programs opening soon, and your document checklist", $"{Math.Max(0, r.NowCount - visible.Count(v => v.Eligible))} opportunités de plus, {r.Soon.Count} programmes bientôt ouverts, et votre liste de documents")</h3>
                    <p>@T("بوصلتك تتجدد كل يوم: فرصة جديدة تناسبك، موعد يقترب، ورقة تجهّزها — وإشعار قبل أن يفتح برنامج تنتظره.", "Your compass refreshes every day: a new match, a closing deadline, a document to prepare — and a heads-up before a program you follow opens.", "Votre boussole se met à jour chaque jour : une nouvelle correspondance, une échéance proche, un document à préparer — et une alerte avant l'ouverture d'un programme.")</p>
                    <a class="cp-btn cp-btn--primary" href="@registerUrl"><i class="bi bi-envelope"></i> @T("بريد وكلمة مرور فقط — دقيقة واحدة", "Email and password only — one minute", "E-mail et mot de passe — une minute")</a>
                    <p style="margin:10px 0 0;font-size:.9rem;">@T("لديك حساب؟", "Already have an account?", "Vous avez déjà un compte ?") <a href="@loginUrl">@T("سجّل الدخول وستجد بوصلتك جاهزة", "Sign in and your compass will be waiting", "Connectez-vous, votre boussole vous attend")</a></p>
                </div>
            </div>
        </section>
    }
    else if (r.NowCount == 0 && r.PartialCount == 0)
    {
        <section class="cp-section">
            <p class="sub">@T("لم نجد اليوم فرصة مفتوحة تطابق إجاباتك. جرّب هدفًا آخر أو أزل «الممولة بالكامل فقط» — أو أنشئ حسابًا لنخبرك فور نشر فرصة تناسبك.", "Try another goal or remove “fully funded only” — or create an account and we'll tell you the moment a matching opportunity is published.", "Essayez un autre objectif ou retirez « entièrement financées seulement » — ou créez un compte pour être prévenu dès qu'une opportunité correspond.")</p>
            <a class="cp-btn cp-btn--primary" href="@registerUrl">@T("أنشئ حسابًا", "Create an account", "Créer un compte")</a>
        </section>
    }
</div>
