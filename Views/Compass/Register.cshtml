@* تسجيل مختصر من البوصلة: بريد وكلمة مرور فقط (بلا تأكيد — زر الإظهار يكفي)؛ الاسم والباقي لاحقًا من الملف الشخصي *@
@model Foras_Khadra.Models.CompassRegisterVM
@{
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var dir = lang == "ar" ? "rtl" : "ltr";
    string T(string ar, string en, string fr) => lang == "en" ? en : lang == "fr" ? fr : ar;
    ViewData["Title"] = T("احفظ بوصلتك", "Save your compass", "Enregistrez votre boussole");
    var loginUrl = Url.Action("Login", "Account", new { returnUrl = Url.Action("Me", "Compass") });
}
<meta name="robots" content="noindex" />
<link asp-append-version="true" rel="stylesheet" href="~/css/compass.css" />

<div class="cp-page cp-auth" dir="@dir">
    <div class="cp-auth__card">
        <span class="cp-kicker"><i class="bi bi-compass"></i> @T("بوصلة", "Compass", "Boussole")</span>
        <h1>@T("أنشئ حسابك في دقيقة", "Create your account in a minute", "Créez votre compte en une minute")</h1>
        <p class="cp-auth__sub">@T("بريد وكلمة مرور فقط. بوصلتك محفوظة وستفتح كاملة فور الدخول.", "Just an email and a password. Your compass is saved and opens fully right away.", "Un e-mail et un mot de passe. Votre boussole est enregistrée et s'ouvre entièrement.")</p>

        @{ ViewData["GoogleReturnUrl"] = Url.Action("Me", "Compass"); }
        @await Html.PartialAsync("_GoogleSignIn")

        <form asp-controller="Compass" asp-action="Register" method="post" data-submit-once>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="cp-err cp-auth__summary"></div>

            <div class="cp-field">
                <label asp-for="Email">@T("البريد الإلكتروني", "Email", "E-mail")</label>
                <input asp-for="Email" type="email" autocomplete="email" inputmode="email" dir="ltr" />
                <span asp-validation-for="Email" class="cp-err"></span>
            </div>
            <div class="cp-field">
                <label asp-for="Password">@T("كلمة المرور", "Password", "Mot de passe")</label>
                <div class="cp-auth__pw">
                    <input asp-for="Password" type="password" autocomplete="new-password" dir="ltr" />
                    <button type="button" class="cp-auth__eye" data-toggle-password aria-label="@T("إظهار كلمة المرور أو إخفاؤها", "Show or hide the password", "Afficher ou masquer le mot de passe")"><i class="bi bi-eye"></i></button>
                </div>
                <span asp-validation-for="Password" class="cp-err"></span>
                <small>@T("8 أحرف على الأقل، وفيها رقم واحد.", "At least 8 characters, including one digit.", "Au moins 8 caractères, dont un chiffre.")</small>
            </div>

            <button type="submit" class="cp-btn cp-btn--orange cp-auth__submit"><i class="bi bi-unlock"></i> @T("احفظ بوصلتي وافتح النتائج", "Save my compass and unlock results", "Enregistrer et débloquer")</button>
        </form>

        <p class="cp-auth__foot">@T("لديك حساب؟", "Already have an account?", "Vous avez déjà un compte ?") <a href="@loginUrl">@T("سجّل الدخول", "Sign in", "Se connecter")</a></p>
        <p class="cp-privacy">@T("نرسل رابط تأكيد للبريد؛ التأكيد مطلوب فقط عند الضغط على «قدّم الآن».", "We email a confirmation link; confirmation is only needed when you press “Apply now”.", "Nous envoyons un lien de confirmation ; il n'est requis qu'au moment de postuler.")</p>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        document.querySelectorAll('[data-toggle-password]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = btn.parentElement.querySelector('input');
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.querySelector('i').className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
            });
        });
    </script>
}
