@* «بوصلتي» للعضو: الآن / قريبًا / جاهزيتك / خطة الأسبوع / تقديماتي + بطاقة المشاركة *@
@model Foras_Khadra.Models.CompassMeVM
@using Foras_Khadra.Models
@{
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var dir = lang == "ar" ? "rtl" : "ltr";
    string T(string ar, string en, string fr) => lang == "en" ? en : lang == "fr" ? fr : ar;
    var r = Model.Result;
    ViewData["Title"] = T("بوصلتي", "My compass", "Ma boussole");
    ViewData["Description"] = ViewData["Title"];
    ViewData["SavedIds"] = Model.SavedIds;
    var confirmed = r.Now.Where(m => m.Confirmed).Take(12).ToList();
    var likely = r.Now.Where(m => m.Eligible && !m.Confirmed).Take(12).ToList();
    var partial = r.Now.Where(m => !m.Eligible).Take(6).ToList();
    var shareText = T($"وجدت {r.NowCount} فرصة تناسبني هذا الشهر على فرص خضراء — اكتشف فرصك في دقيقتين:", $"I found {r.NowCount} opportunities that fit me this month on Foras Khadra — find yours in two minutes:", $"J'ai trouvé {r.NowCount} opportunités qui me correspondent ce mois-ci sur Foras Khadra — trouvez les vôtres en deux minutes :");
    var newText = r.NewThisWeek > 0 ? T($" — {r.NewThisWeek} جديدة هذا الأسبوع", $" — {r.NewThisWeek} new this week", $" — {r.NewThisWeek} nouvelles cette semaine") : "";
    string MonthName(DateTime d) => d.ToString("MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo(lang == "ar" ? "ar-EG" : lang == "fr" ? "fr-FR" : "en-GB"));
}
<link asp-append-version="true" rel="stylesheet" href="~/css/compass.css" />

<div class="cp-page" dir="@dir">
    <section class="cp-hero">
        <span class="cp-kicker"><i class="bi bi-compass"></i> @T("بوصلتي", "My compass", "Ma boussole") · @Model.Answers.CompletionPercent%</span>
        @if (r.ConfirmedCount > 0)
        {
            <h1>@T("أهلًا ", "Hi ", "Bonjour ")@Model.FirstName@T("، أنت مؤهَّل الآن لـ", ", you qualify right now for ", ", vous êtes éligible maintenant à ")<b>@r.ConfirmedCount</b> @T("فرصة", "opportunities", "opportunités")@(r.LikelyCount > 0 ? T($"، و{r.LikelyCount} أخرى تحتاج مراجعة شروطها", $", and {r.LikelyCount} more need a requirements check", $", et {r.LikelyCount} autres demandent une vérification") : "")@newText.</h1>
        }
        else
        {
            <h1>@T("أهلًا ", "Hi ", "Bonjour ")@Model.FirstName@T("، وجدنا لك ", ", we found ", ", nous avons trouvé ")<b>@r.LikelyCount</b> @T("فرصة تناسبك — راجع شروطها قبل التقديم", "opportunities that fit you — check their requirements before applying", "opportunités qui vous correspondent — vérifiez leurs conditions avant de postuler")@newText.</h1>
        }
        <p>@T("تتجدد كل يوم مع كل فرصة تُنشر. كل بطاقة تشرح لماذا تناسبك، وما ينقصك، وما لم نتحقق منه.", "Refreshed every day as opportunities are published. Each card explains why it fits, what is missing and what we could not verify.", "Mise à jour chaque jour. Chaque carte explique pourquoi elle vous convient, ce qu'il manque et ce que nous n'avons pas pu vérifier.")</p>
        <div class="cp-stats">
            <div class="cp-stat"><b>@r.ConfirmedCount</b><span>@T("أهلية مؤكَّدة", "confirmed", "confirmées")</span></div>
            <div class="cp-stat"><b>@r.LikelyCount</b><span>@T("تحتاج مراجعة", "to check", "à vérifier")</span></div>
            <div class="cp-stat"><b>@r.PartialCount</b><span>@T("ينقصها شرط", "one requirement away", "à une condition près")</span></div>
            <div class="cp-stat"><b>@r.Soon.Count</b><span>@T("تفتح قريبًا", "opening soon", "bientôt ouvertes")</span></div>
        </div>
        <div class="cp-links">
            <a href="@Url.Action("Index", "Compass", new { edit = true })"><i class="bi bi-pencil"></i> @T("عدّل إجاباتك", "Edit answers", "Modifier mes réponses")</a>
            <a href="@Url.Action("Saved", "Opportunity")"><i class="bi bi-bookmark-check"></i> @T("تقديماتي ومحفوظاتي", "My applications and saved", "Mes candidatures")</a>
            <a href="@Url.Action("Dashboard", "User")"><i class="bi bi-person"></i> @T("صفحتي", "My page", "Ma page")</a>
        </div>
    </section>

    @if (r.Week.Count > 0)
    {
        <section class="cp-section">
            <h2><i class="bi bi-calendar-week"></i> @T("خطة هذا الأسبوع", "This week's plan", "Plan de la semaine")</h2>
            <ul class="cp-week">
                @foreach (var w in r.Week)
                {
                    <li>
                        <i class="bi @(w.Kind == "deadline" ? "bi-alarm" : w.Kind == "new" ? "bi-stars" : "bi-file-earmark-check")"></i>
                        @if (w.OpportunityId.HasValue) { <a href="@Url.Action("Details", "Opportunity", new { id = w.OpportunityId })">@w.Text</a> } else { <a href="#readiness">@w.Text</a> }
                    </li>
                }
            </ul>
        </section>
    }

    <section class="cp-section">
        <h2><i class="bi bi-patch-check"></i> @T("الآن — أهلية مؤكَّدة", "Now — eligibility confirmed", "Maintenant — éligibilité confirmée")</h2>
        <p class="sub">@T("كل شرط نعرفه عن هذه الفرص طابق إجاباتك. مرتبة بدرجة التطابق والموعد؛ احفظ ما يعنيك لتتابعه بقائمة أوراق خاصة به.", "Every requirement we know for these matches your answers. Ranked by match and deadline; save what matters to track it with its own checklist.", "Chaque condition connue correspond à vos réponses. Classées par correspondance et échéance ; enregistrez ce qui vous intéresse.")</p>
        @if (confirmed.Count == 0)
        {
            <p class="sub">@(likely.Count > 0
                ? T("لا فرصة تأكدنا من كل شروطها اليوم. الفرص أدناه تناسبك وتحتاج مراجعة شرط أو اثنين — وأكمل إجاباتك لنتحقق من المزيد.", "Nothing fully verified today. The ones below fit you and need a requirement or two checked — complete your answers so we can verify more.", "Rien d'entièrement vérifié aujourd'hui. Celles ci-dessous vous correspondent et demandent une ou deux vérifications — complétez vos réponses.")
                : T("لا فرصة مطابقة اليوم. وسّع أهدافك أو أزل «الممولة بالكامل فقط».", "Nothing matching today. Widen your goals or remove “fully funded only”.", "Rien de correspondant aujourd'hui. Élargissez vos objectifs ou retirez « entièrement financées seulement »."))</p>
        }
        <div class="cp-cards">
            @foreach (var m in confirmed) { @await Html.PartialAsync("_CompassCard", m) }
        </div>
        @if (likely.Count > 0)
        {
            <h2 style="margin-top:18px;"><i class="bi bi-search"></i> @T("تناسبك — راجع الشروط", "Fits you — check the requirements", "Vous correspond — vérifiez les conditions")</h2>
            <p class="sub">@T("لا نقص معروف، لكن شرطًا لم يُذكر في بياناتنا أو لم تُجب عنه. البطاقة تقول أيّ شرط.", "No known gap, but a requirement is missing from our data or your answers. The card says which.", "Aucun manque connu, mais une condition manque dans nos données ou vos réponses. La carte précise laquelle.")</p>
            <div class="cp-cards">
                @foreach (var m in likely) { @await Html.PartialAsync("_CompassCard", m) }
            </div>
        }
        @if (partial.Count > 0)
        {
            <h2 style="margin-top:18px;"><i class="bi bi-exclamation-circle"></i> @T("ينقصك شرط واحد", "One requirement away", "À une condition près")</h2>
            <div class="cp-cards">
                @foreach (var m in partial) { @await Html.PartialAsync("_CompassCard", m) }
            </div>
        }
    </section>

    @if (r.Soon.Count > 0)
    {
        <section class="cp-section">
            <h2><i class="bi bi-hourglass"></i> @T("قريبًا", "Opening soon", "Bientôt")</h2>
            <p class="sub">@T("برامج متكررة تناسبك ومغلقة الآن. ابدأ التجهيز قبل أن تفتح.", "Recurring programs that fit you and are closed now. Start preparing before they open.", "Programmes récurrents qui vous correspondent et fermés pour l'instant. Préparez-vous avant l'ouverture.")</p>
            <div class="cp-soon">
                @foreach (var s in r.Soon)
                {
                    var o = s.LastCycle;
                    var title = lang == "en" ? o.TitleEn : lang == "fr" ? o.TitleFr : o.TitleAr;
                    <div class="cp-soon__item">
                        <b><a href="@Url.Action("Details", "Opportunity", new { id = o.Id })" style="color:inherit;text-decoration:none;">@title</a></b>
                        <span class="cp-soon__when"><i class="bi bi-calendar-event"></i> @(s.ExpectedOpen.HasValue ? T("يفتح عادةً في " + MonthName(s.ExpectedOpen.Value), "Usually opens in " + MonthName(s.ExpectedOpen.Value), "Ouvre généralement en " + MonthName(s.ExpectedOpen.Value)) : T("دورة جديدة متوقعة", "New cycle expected", "Nouveau cycle attendu"))</span>
                        <small>@string.Join(" · ", s.Reasons)</small>
                        @if (!string.IsNullOrEmpty(o.ProgramKey) && ViewBag.GuideSlugs is Dictionary<string, string> guideSlugs && guideSlugs.TryGetValue(o.ProgramKey, out var guideSlug))
                        {
                            <a href="@Url.Action("Details", "Guides", new { slug = guideSlug })" style="display:inline-block;margin-top:6px;font-weight:700;color:#1B6B23;"><i class="bi bi-journal-bookmark"></i> @T("دليل التقديم: ابدأ التجهيز الآن", "Application guide: start preparing now", "Guide de candidature : commencez maintenant")</a>
                        }
                        <form asp-controller="Tracker" asp-action="ToggleCycleWatch" asp-route-id="@o.Id" asp-route-returnUrl="@Url.Action("Me", "Compass")" method="post" style="margin-top:8px;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="cp-btn" style="padding:6px 12px;font-size:.9rem;"><i class="bi bi-bell"></i> @T("أعلمني حين تفتح", "Notify me when it opens", "Prévenez-moi à l'ouverture")</button>
                        </form>
                    </div>
                }
            </div>
        </section>
    }

    <section class="cp-section" id="readiness">
        <h2><i class="bi bi-file-earmark-check"></i> @T("جاهزيتك", "Your readiness", "Votre préparation")</h2>
        <p class="sub">@T("قائمة أوراق واحدة تُستعمل لكل التقديمات. علّم ما جهّزته، ونخبرك أي ورقة تفتح لك أكبر عدد من الفرص.", "One document list for all applications. Tick what you have, and we tell you which document unlocks the most opportunities.", "Une seule liste de documents pour toutes vos candidatures. Cochez ce que vous avez.")</p>
        <div class="cp-ready">
            <b>@T($"جاهز بنسبة {r.ReadinessPercent}%", $"{r.ReadinessPercent}% ready", $"Prêt à {r.ReadinessPercent}%")</b>
            <div class="cp-ready__bar"><span style="width:@r.ReadinessPercent%"></span></div>
            <ul>
                @foreach (var d in r.Readiness)
                {
                    <li>
                        <form asp-controller="Compass" asp-action="Document" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="key" value="@d.Key" />
                            <input type="hidden" name="have" value="@(d.Have ? "false" : "true")" />
                            <button type="submit" class="@(d.Have ? "is-done" : "")" title="@(d.Have ? T("علّم كغير جاهزة", "Mark as not ready", "Marquer comme non prêt") : T("علّم كجاهزة", "Mark as ready", "Marquer comme prêt"))">
                                <i class="bi @(d.Have ? "bi-check-circle-fill" : "bi-circle")"></i>
                                <span>@d.Label</span>
                                @if (!d.Have && d.Unlocks > 0) { <small>+@d.Unlocks</small> }
                            </button>
                        </form>
                    </li>
                }
            </ul>
            @if (r.Readiness.Count == 0)
            {
                <p class="sub" style="margin:0;">@T("اختر هدفًا في إجاباتك لنعرض أوراقه.", "Pick a goal in your answers to see its documents.", "Choisissez un objectif pour voir ses documents.")</p>
            }
        </div>
    </section>

    <section class="cp-section">
        <h2><i class="bi bi-share"></i> @T("شارك بوصلتك", "Share your compass", "Partagez votre boussole")</h2>
        <div class="cp-share">
            <b>@shareText</b>
            <input type="text" readonly value="@Model.ShareUrl" onclick="this.select()" aria-label="@T("رابط الإحالة", "Referral link", "Lien de parrainage")" />
            <a class="cp-btn cp-btn--primary" target="_blank" rel="noopener" href="https://wa.me/?text=@Uri.EscapeDataString(shareText + " " + Model.ShareUrl)"><i class="bi bi-whatsapp"></i> WhatsApp</a>
            <a class="cp-btn" target="_blank" rel="noopener" href="https://twitter.com/intent/tweet?text=@Uri.EscapeDataString(shareText)&url=@Uri.EscapeDataString(Model.ShareUrl)"><i class="bi bi-twitter-x"></i></a>
        </div>
    </section>
</div>
