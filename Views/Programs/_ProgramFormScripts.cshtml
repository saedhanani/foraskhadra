@* سكربتات نموذج المشروع الرائد: 6 محررات Quill، صفوف الأرقام والمحطات، ومنطقة رفع الصورة *@
@model FlagshipProgram
<partial name="_ValidationScriptsPartial" />
<script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script>
<script>
    const toolbarOptions = [
        [{ header: [2, 3, false] }],
        ['bold', 'italic', 'underline'],
        [{ list: 'ordered' }, { list: 'bullet' }],
        ['link'],
        ['clean']
    ];

    function editor(selector, placeholder, hiddenId) {
        const q = new Quill(selector, { theme: 'snow', placeholder, modules: { toolbar: toolbarOptions } });
        const hidden = document.getElementById(hiddenId);
        if (hidden.value) q.root.innerHTML = hidden.value;
        return { q, hidden };
    }

    const editors = [
        editor('#editorIntroAr', 'التعريف بالمشروع بالعربي...', 'IntroAr'),
        editor('#editorIntroEn', 'Project introduction in English...', 'IntroEn'),
        editor('#editorIntroFr', 'Présentation du projet en français...', 'IntroFr'),
        editor('#editorOutcomesAr', 'المخرجات بالعربي (قائمة نقاط)...', 'OutcomesAr'),
        editor('#editorOutcomesEn', 'Outputs in English...', 'OutcomesEn'),
        editor('#editorOutcomesFr', 'Résultats en français...', 'OutcomesFr')
    ];

    // بالمعرّف لا بـ querySelector('form'): القالب يحوي نماذج أخرى قبل هذا
    document.getElementById('programForm').addEventListener('submit', function () {
        editors.forEach(e => { e.hidden.value = e.q.root.innerText.trim() ? e.q.root.innerHTML : ''; });
        reindexAll();
    });

    // ----- صفوف الأرقام والمحطات: الأسماء Stats[i].Value / Timeline[i].Year تُعاد ترقيمها قبل الإرسال -----
    const firstField = { Stats: 'Value', Timeline: 'Year' };
    const firstPlaceholder = { Stats: '22+', Timeline: '2026' };

    function reindex(container) {
        const prefix = container.dataset.prefix;
        container.querySelectorAll('.dynamic-row').forEach((row, i) => {
            const inputs = row.querySelectorAll('input');
            inputs[0].name = `${prefix}[${i}].${firstField[prefix]}`;
            inputs[1].name = `${prefix}[${i}].Ar`;
            inputs[2].name = `${prefix}[${i}].En`;
            inputs[3].name = `${prefix}[${i}].Fr`;
        });
    }
    function reindexAll() { document.querySelectorAll('.dynamic-rows').forEach(reindex); }

    document.querySelectorAll('.row-add').forEach(btn => {
        btn.addEventListener('click', () => {
            const container = document.getElementById(btn.dataset.target);
            const row = document.getElementById('rowTemplate').content.firstElementChild.cloneNode(true);
            row.querySelector('[data-field="A"]').placeholder = firstPlaceholder[container.dataset.prefix];
            container.appendChild(row);
            reindex(container);
            row.querySelector('input').focus();
        });
    });

    document.addEventListener('click', e => {
        const remove = e.target.closest('.row-remove');
        if (!remove) return;
        const container = remove.closest('.dynamic-rows');
        remove.closest('.dynamic-row').remove();
        reindex(container);
    });

    // ----- رفع الصورة الرئيسية -----
    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('fileInput');
    const fileNameDisplay = document.getElementById('fileNameDisplay');
    const previewContainer = document.getElementById('previewContainer');

    dropzone.addEventListener('click', () => fileInput.click());
    dropzone.addEventListener('dragover', e => { e.preventDefault(); dropzone.classList.add('dragover'); });
    dropzone.addEventListener('dragleave', () => dropzone.classList.remove('dragover'));
    dropzone.addEventListener('drop', e => {
        e.preventDefault();
        dropzone.classList.remove('dragover');
        if (e.dataTransfer.files.length > 0) { fileInput.files = e.dataTransfer.files; handleFiles(e.dataTransfer.files[0]); }
    });
    fileInput.addEventListener('change', e => { if (e.target.files.length > 0) handleFiles(e.target.files[0]); });

    function handleFiles(file) {
        if (file && file.type.startsWith('image/')) {
            fileNameDisplay.textContent = `تم اختيار: ${file.name}`;
            previewContainer.classList.remove('d-none');
        } else {
            alert('يرجى اختيار صورة فقط');
        }
    }
</script>
