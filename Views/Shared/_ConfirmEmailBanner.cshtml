@{
    // شريط «أكّد بريدك» للمسجَّل الذي لم يؤكد بعد — يُعرض حيث يلزم التأكيد (صفحة الفرصة)
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    string T(string ar, string en, string fr) => culture == "en" ? en : culture == "fr" ? fr : ar;
    var returnUrl = ViewData["ReturnUrl"] as string ?? Context.Request.Path.ToString();
}
<div class="confirm-email-banner" style="display:flex;flex-wrap:wrap;align-items:center;gap:10px;background:#fff7e6;border:1px solid #f5d28c;border-radius:12px;padding:10px 14px;margin:10px 0;font-size:.92rem;">
    <i class="bi bi-envelope-exclamation" style="color:#b7791f;font-size:1.2rem;"></i>
    <span style="flex:1;min-width:200px;">@T("أكّد بريدك لتفتح روابط التقديم — أرسلنا لك رابط التأكيد عند التسجيل.", "Confirm your email to open apply links — we sent you the link when you registered.", "Confirmez votre e-mail pour ouvrir les liens de candidature — le lien vous a été envoyé à l'inscription.")</span>
    <form asp-controller="Account" asp-action="ResendConfirmation" method="post" style="margin:0;">
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <button type="submit" class="btn btn-sm" style="background:#1B6B23;color:#fff;border-radius:8px;">@T("أعد الإرسال", "Resend", "Renvoyer")</button>
    </form>
</div>
