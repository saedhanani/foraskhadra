@* زر «المتابعة بحساب Google» + فاصل «أو». returnUrl من ViewData["GoogleReturnUrl"] وإلا ViewData["ReturnUrl"]
   (لا نمرّر نموذجًا: النموذج null يجعل Razor يمرّر نموذج الصفحة الأم). لا يظهر شيء إذا لم تُضبط مفاتيح Google،
   عدا رسالة فشل الدخول بـ Google إن وُجدت. يوضع خارج أي <form> آخر. *@
@using Microsoft.AspNetCore.Identity
@using Foras_Khadra.Models
@inject SignInManager<ApplicationUser> SignInManager
@{
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    string T(string ar, string en, string fr) => lang == "en" ? en : lang == "fr" ? fr : ar;
    var google = (await SignInManager.GetExternalAuthenticationSchemesAsync())
        .FirstOrDefault(s => s.Name == Foras_Khadra.Helpers.GoogleSignIn.Scheme);
    var error = TempData["ExternalLoginError"] as string;
    var returnUrl = ViewData["GoogleReturnUrl"] as string ?? ViewData["ReturnUrl"] as string;
    // اتجاه صريح: بعض الصفحات (التسجيل) تفرض direction:rtl في CSS حتى بالإنجليزية
    var dir = lang == "ar" ? "rtl" : "ltr";
}
@if (!string.IsNullOrEmpty(error))
{
    <div class="gsi-error" role="alert" dir="@dir">@error</div>
}
@if (google != null)
{
    <form asp-controller="Account" asp-action="ExternalLogin" method="post" class="gsi-form" dir="@dir" data-submit-once>
        <input type="hidden" name="provider" value="@google.Name" />
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <button type="submit" class="gsi-btn">
            <svg class="gsi-logo" width="20" height="20" viewBox="0 0 48 48" aria-hidden="true">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
            </svg>
            <span>@T("المتابعة بحساب Google", "Continue with Google", "Continuer avec Google")</span>
        </button>
        <p class="gsi-note">@T("بلا كلمة مرور ولا رسالة تأكيد.", "No password and no confirmation email.", "Sans mot de passe ni e-mail de confirmation.")</p>
    </form>
    <div class="gsi-or" aria-hidden="true" dir="@dir"><span>@T("أو", "or", "ou")</span></div>
}
@if (google != null || !string.IsNullOrEmpty(error))
{
<style>
    .gsi-form { margin: 18px 0 0; text-align: center; }
    .gsi-form[dir="ltr"], .gsi-or[dir="ltr"], .gsi-error[dir="ltr"] { direction: ltr; }
    .gsi-form[dir="rtl"], .gsi-or[dir="rtl"], .gsi-error[dir="rtl"] { direction: rtl; }
    .gsi-btn {
        display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%;
        min-height: 48px; padding: 10px 14px; border-radius: 10px;
        background: #fff; border: 1px solid #747775; color: #1f1f1f;
        font-weight: 700; font-size: 15px; cursor: pointer;
        transition: background-color .15s ease, box-shadow .15s ease;
    }
    .gsi-btn:hover { background: #f8faf8; box-shadow: 0 1px 3px rgba(0,0,0,.12); }
    .gsi-btn:focus-visible { outline: 3px solid rgba(66,133,244,.45); outline-offset: 2px; }
    .gsi-logo { flex: 0 0 auto; }
    .gsi-form .gsi-note { margin: 6px 0 0; font-size: 12px; color: #5f6b63; text-align: center; }
    .gsi-or { display: flex; align-items: center; gap: 12px; margin: 16px 0 4px; color: #6b766f; font-size: 13px; }
    .gsi-or::before, .gsi-or::after { content: ""; flex: 1; height: 1px; background: #dfe7e2; }
    .gsi-error {
        margin: 16px 0 0; padding: 10px 12px; border-radius: 10px;
        background: #fff4e5; border: 1px solid #f9c98a; color: #7a4a00; font-size: 14px; text-align: start;
    }
</style>
}
