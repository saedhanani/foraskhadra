@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var dir = culture == "ar" ? "rtl" : "ltr";
    string T(string ar, string en, string fr) => culture == "en" ? en : culture == "fr" ? fr : ar;
    var ok = ViewData["Success"] as bool? ?? false;
    var message = ViewData["Message"] as string ?? "";
    ViewData["Title"] = ok ? T("تم تأكيد البريد", "Email confirmed", "E-mail confirmé") : T("تعذّر التأكيد", "Confirmation failed", "Échec de la confirmation");
}
<div class="auth-page" dir="@dir" style="min-height:calc(100vh - 120px);display:flex;align-items:center;justify-content:center;background:#F2FBF3;padding:24px 16px;">
    <div class="auth-card auth-success" style="background:#fff;border-radius:20px;padding:40px 28px;max-width:520px;width:100%;text-align:center;box-shadow:0 10px 30px rgba(27,107,35,.08);">
        <div style="font-size:64px;line-height:1;margin-bottom:12px;">@(ok ? "✅" : "⚠️")</div>
        <h1 style="font-size:1.6rem;color:#1B6B23;margin-bottom:10px;">@ViewData["Title"]</h1>
        <p style="color:#444;">@message</p>
        <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:22px;">
            @if (ok)
            {
                if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Opportunity" asp-action="Saved" class="btn auth-btn" style="background:#1B6B23;color:#fff;border-radius:10px;padding:10px 22px;">@T("فرصي", "My opportunities", "Mes opportunités")</a>
                    <a asp-controller="Home" asp-action="AllOpportunities" class="btn" style="border:1px solid #1B6B23;color:#1B6B23;border-radius:10px;padding:10px 22px;">@T("تصفح الفرص", "Browse opportunities", "Parcourir les opportunités")</a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn auth-btn" style="background:#1B6B23;color:#fff;border-radius:10px;padding:10px 22px;">@T("تسجيل الدخول", "Sign in", "Se connecter")</a>
                }
            }
            else if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Account" asp-action="ResendConfirmation" method="post">
                    <button type="submit" class="btn auth-btn" style="background:#1B6B23;color:#fff;border-radius:10px;padding:10px 22px;">@T("أعد إرسال رابط التأكيد", "Resend confirmation link", "Renvoyer le lien")</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn auth-btn" style="background:#1B6B23;color:#fff;border-radius:10px;padding:10px 22px;">@T("تسجيل الدخول ثم إعادة الإرسال", "Sign in to resend", "Se connecter pour renvoyer")</a>
            }
        </div>
    </div>
</div>
