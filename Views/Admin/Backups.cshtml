@model IReadOnlyList<Foras_Khadra.Services.BackupFileInfo>
@{
    ViewData["Title"] = "النسخ الاحتياطي";
    var folder = ViewData["Folder"] as string;
}
<div class="container py-4" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 class="m-0">النسخ الاحتياطي اليومي</h2>
        <div class="d-flex gap-2">
            <form asp-controller="Admin" asp-action="RunBackup" method="post">
                <button type="submit" class="btn btn-success">نسخة الآن</button>
            </form>
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary">لوحة التحكم</a>
        </div>
    </div>
    <p class="text-muted">
        تُكتب نسخة من كل الجداول (بلا كلمات المرور ورموز الاستعادة) كل يوم بعد الساعة 3 فجرًا بتوقيت الخادم إلى
        <code dir="ltr">@folder</code>، ويُحتفظ بآخر 14 يومًا. هذه شبكة أمان؛ النسخة الكاملة من لوحة الاستضافة تبقى أسبوعيًا.
    </p>
    @if (TempData["BackupMessage"] is string msg)
    {
        <div class="alert alert-success">@msg</div>
    }
    @if (!Model.Any())
    {
        <div class="alert alert-light border text-center py-4">لا توجد نسخ بعد — اضغط «نسخة الآن».</div>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead><tr><th>الملف</th><th>الحجم</th><th>التاريخ</th><th></th></tr></thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td dir="ltr">@f.Name</td>
                        <td>@((f.Bytes / 1024.0).ToString("N0")) KB</td>
                        <td>@f.CreatedAt.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)</td>
                        <td><a class="btn btn-sm btn-outline-primary" asp-controller="Admin" asp-action="DownloadBackup" asp-route-name="@f.Name">تنزيل</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
