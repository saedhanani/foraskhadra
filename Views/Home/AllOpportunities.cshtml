    .ob-faq h2 { font-size: 1.2rem; font-weight: 800; color: #1B6B23; margin: 0 0 8px; }
    .ob-faq details { border-bottom: 1px solid #E5E7EB; padding: 10px 0; }
    .ob-faq details:last-child { border-bottom: 0; }
    .ob-faq summary { cursor: pointer; font-weight: 700; color: #0F3D14; }
    .ob-faq p { margin: 8px 0 0; color: #475569; line-height: 1.8; }
</style>

<div class="page-wrapper container">
    <header class="custom-header">
        <div class="header-right">
            <div class="header-logo">
                <img src="/images/about_us_leaf.svg" alt="Logo" />
            </div>
            <h1 class="header-title">@(lp != null ? lp.Title(lang) : tp != null ? tp.Title(lang) : customTitle ?? Localizer["all_opportunities"].Value)</h1>
        </div>

        <div class="header-left">
            <div class="filter-btn" id="filterToggleBtn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" y1="21" x2="4" y2="14"></line>
                    <line x1="4" y1="10" x2="4" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12" y2="3"></line>
                    <line x1="20" y1="21" x2="20" y2="16"></line>
                    <line x1="20" y1="12" x2="20" y2="3"></line>
                    <line x1="1" y1="14" x2="7" y2="14"></line>
                    <line x1="9" y1="8" x2="15" y2="8"></line>
                    <line x1="17" y1="16" x2="23" y2="16"></line>
                </svg>
            </div>
        </div>

        <div class="filter-window shadow" id="filterWindow">
            <div class="filter-window-header">
                <span class="sort-by-label">
                    @Localizer["sort_by"]
                    <i class="bi bi-caret-up-fill" style="font-size: 0.7rem; color: #B6C7B9;"></i>
                </span>
                <a href="@Url.Action("AllOpportunities", "Home")" class="reset-link">@Localizer["reset"]</a>
            </div>

            <form method="get">
                <div class="mb-3">
                    <input type="text"
                           name="search"
                           class="form-control border-1 shadow-sm"
                           placeholder="@(lang switch
                           {
                               "en" => "Opportunity Name",
                               "fr" => "Une Opportunité",
                               _ => "اسم الفرصة"
                           })"
                           value="@Context.Request.Query["search"]"
                           style="font-size:0.9rem;">
                </div>

                <div class="filter-option-item active" id="typeOptionTrigger">
                    <span>
                        @(lang switch
                        {
                            "en" => "Opportunity Type",
                            "fr" => "Type d'opportunité",
                            _ => "نوع الفرصة"
                        })
                    </span>
                    <i class="bi bi-caret-left-fill"></i>
                </div>

                <div class="filter-option-item" id="countryOptionTrigger">
                    <span>@Localizer["country"]</span>
                    <i class="bi bi-caret-left-fill"></i>
                </div>

                <div class="sub-filter-menu shadow" id="countrySubMenu">
                    <div class="p-2">
                        <label class="form-label mb-2" style="font-size: 0.9rem; color: #666;">@Localizer["enter_country_name"]</label>
                        <input type="text"
                               name="country"
                               class="form-control border-1 shadow-sm"
                               placeholder="@Localizer["PS"]"
                               value="@Model.SelectedCountry"
                               id="countryInput"
                               style="font-size: 0.9rem; direction: rtl;">
                    </div>
                    <div class="sub-menu-footer mt-3">
                        <button type="button" class="btn-cancel-sub" id="cancelCountrySub">@Localizer["cancel"]</button>
                        <button type="submit" class="btn-search-sub">@Localizer["search"]</button>
                    </div>
                </div>

                <div class="sub-filter-menu shadow" id="typeSubMenu">
                    @foreach (var item in Model.TypeSelectList)
                    {
                        <label class="checkbox-item">
                            <input type="checkbox" name="type" value="@item.Value" @(item.Selected ? "checked" : "")>
                            @item.Text
                        </label>
                    }

                    <div class="sub-menu-footer">
                        <button type="button" class="btn-cancel-sub" id="cancelSub">@Localizer["cancel"]</button>
                        <button type="submit" class="btn-search-sub">@Localizer["search"]</button>
                    </div>
                </div>
            </form>
        </div>
    </header>

    @if (lp != null)
    {
        foreach (var para in (lp.Intro(lang) ?? "").Split("\n\n", StringSplitOptions.RemoveEmptyEntries))
        {
            <p class="ob-intro">@para.Trim()</p>
        }
    }
    else if (tp != null)
    {
        <p class="ob-intro">@tp.Intro(lang)</p>
    }
    else if (ViewData["ListIntro"] is string listIntro)
    {
        <p class="ob-intro">@listIntro</p>
        @if (ViewData["ListWithin"] is int within)
        {
            <p class="ob-intro">
                <a class="@(within == 7 ? "fw-bold" : "")" href="@Url.Action("ClosingSoon", "Home")">@T("خلال 7 أيام", "Within 7 days", "Sous 7 jours")</a> ·
                <a class="@(within == 15 ? "fw-bold" : "")" href="@Url.Action("ClosingSoon", "Home", new { within = 15 })">@T("خلال 15 يومًا", "Within 15 days", "Sous 15 jours")</a> ·
                <a href="@ViewData["FeedUrl"]" type="application/atom+xml"><i class="bi bi-rss" aria-hidden="true"></i> @T("خلاصة RSS", "RSS feed", "Flux RSS")</a>
            </p>
        }
    }

    @* بحث ظاهر + فلاتر من الحقول المهيكلة + ترتيب + عدّاد + رقائق (المرحلة 2.2) — تتغيّر فتُرسل تلقائيًا *@
    <form method="get" class="ob-bar" action="@clearUrl" id="obForm">
        @if (tp == null && lp == null)
        {
            foreach (var t in f.Types) { <input type="hidden" name="type" value="@t" /> }
        }
        @if (f.CountryName != null && lp == null) { <input type="hidden" name="country" value="@f.CountryName" /> }
        <div class="ob-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" name="search" value="@f.Search" maxlength="100" placeholder="@T("ابحث: منحة ماجستير في ألمانيا…", "Search: master's scholarship in Germany…", "Rechercher : bourse de master en Allemagne…")" aria-label="@T("بحث", "Search", "Rechercher")" />
            <button type="submit">@T("بحث", "Search", "Rechercher")</button>
        </div>
        <div class="ob-filters">
            @if (f.CountryName == null)
            {
                <select name="country" aria-label="@T("دولتي", "My country", "Mon pays")">
                    <option value="">@T("دولتي", "My country", "Mon pays")</option>
                    @foreach (var c in Model.CountryOptions) { <option value="@c.Iso" selected="@(f.CountryIso == c.Iso)">@c.Name</option> }
                    <option value="XA" selected="@(f.CountryIso == "XA")">@T("كل الوطن العربي", "The whole Arab world", "Tout le monde arabe")</option>
                </select>
            }
            <select name="funding" aria-label="@T("التمويل", "Funding", "Financement")">
                <option value="">@T("التمويل", "Funding", "Financement")</option>
                @foreach (var v in new[] { FundingType.FullyFunded, FundingType.PartiallyFunded, FundingType.SelfFunded, FundingType.Paid }) { <option value="@v" selected="@(f.Funding == v)">@FundingName(v)</option> }
            </select>
            <select name="degree" aria-label="@T("المرحلة", "Level", "Niveau")">
                <option value="">@T("المرحلة", "Level", "Niveau")</option>
                @foreach (var v in new[] { DegreeLevels.HighSchool, DegreeLevels.Bachelor, DegreeLevels.Master, DegreeLevels.PhD, DegreeLevels.Postdoc, DegreeLevels.Professional }) { <option value="@v" selected="@(f.Degree == v)">@DegreeName(v)</option> }
            </select>
            <select name="field" aria-label="@T("المجال", "Field", "Domaine")">
                <option value="">@T("المجال", "Field", "Domaine")</option>
                @foreach (var x in Model.Fields) { <option value="@x.Key" selected="@f.Fields.Contains(x.Key)">@FieldName(x)</option> }
            </select>
            <select name="theme" aria-label="@T("المحور الأخضر", "Green theme", "Axe vert")">
                <option value="">@T("المحور الأخضر", "Green theme", "Axe vert")</option>
                @foreach (var v in new[] { GreenThemes.Climate, GreenThemes.Energy, GreenThemes.Water, GreenThemes.Biodiversity, GreenThemes.CircularEconomy, GreenThemes.Agriculture, GreenThemes.SustainableCities, GreenThemes.Policy }) { <option value="@v" selected="@(f.Theme == v)">@ThemeName(v)</option> }
            </select>
            @if (Model.HostOptions.Count > 0)
            {
                <select name="host" aria-label="@T("بلد الاستضافة", "Host country", "Pays d'accueil")">
                    <option value="">@T("بلد الاستضافة", "Host country", "Pays d'accueil")</option>
                    @foreach (var h in Model.HostOptions) { <option value="@h.Iso" selected="@(f.Host == h.Iso)">@h.Name</option> }
                </select>
            }
            <select name="within" aria-label="@T("ينتهي خلال", "Closes within", "Se clôture sous")">
                <option value="">@T("ينتهي خلال…", "Closes within…", "Se clôture sous…")</option>
                @foreach (var d in OpportunityFilter.WithinOptions) { <option value="@d" selected="@(f.Within == d)">@T($"{d} يومًا", $"{d} days", $"{d} jours")</option> }
            </select>
            <label class="ob-toggle"><input type="checkbox" name="remote" value="true" checked="@f.Remote" /> @T("عن بُعد", "Remote", "À distance")</label>
            <label class="ob-toggle"><input type="checkbox" name="noielts" value="true" checked="@f.NoIelts" /> @T("بدون آيلتس", "No IELTS", "Sans IELTS")</label>
            <label class="ob-toggle"><input type="checkbox" name="women" value="true" checked="@f.Women" /> @T("للنساء", "For women", "Pour les femmes")</label>
            <select name="sort" aria-label="@T("الترتيب", "Sort", "Tri")">
                <option value="" selected="@(f.Sort == "open")">@T("المفتوحة أولًا", "Open first", "Ouvertes d'abord")</option>
                <option value="deadline" selected="@(f.Sort == "deadline")">@T("الأقرب موعدًا", "Closest deadline", "Échéance proche")</option>
                <option value="newest" selected="@(f.Sort == "newest")">@T("الأحدث", "Newest", "Plus récentes")</option>
            </select>
        </div>
    </form>
    <div class="ob-status">
        <span class="ob-count"><b>@Model.TotalCount.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</b> @T("فرصة", "opportunities", "opportunités")</span>
        @foreach (var chip in chips)
        {
            <a class="ob-chip" href="@chip.Url" rel="nofollow">@chip.Label <i class="bi bi-x"></i></a>
        }
        @if (chips.Count > 0)
        {
            <a class="ob-clear" href="@clearUrl">@T("مسح الكل", "Clear all", "Tout effacer")</a>
        }
    </div>

    @{
        // شريط "احفظ هذا البحث": يظهر للمسجّل عندما يكون ثمة بحث أو فلتر فعّال
        var qSearch = Context.Request.Query["search"].ToString();
        var qTypes = Context.Request.Query["type"].ToArray();
        var qCountry = Model.SelectedCountry ?? "";
        var hasCriteria = !string.IsNullOrWhiteSpace(qSearch) || qTypes.Any(t => !string.IsNullOrEmpty(t)) || !string.IsNullOrEmpty(qCountry);
    }
    @if (TempData["SavedSearchMsg"] is string savedMsg)
    {
        <div class="alert d-flex align-items-center gap-2" style="background:#f0f7ee; border:1px solid #ABE188; color:#1B6B23; border-radius:12px; font-weight:600;">
            <i class="bi bi-bell-fill"></i> @savedMsg
        </div>
    }
    @if (hasCriteria && User.Identity?.IsAuthenticated == true && !User.IsInRole("Organization"))
    {
        <form method="post" asp-controller="SavedSearch" asp-action="Save" class="d-flex align-items-center gap-2 flex-wrap mb-4"
              style="background:#fff; border:1.5px dashed #ABE188; border-radius:14px; padding:12px 16px;">
            <input type="hidden" name="search" value="@qSearch" />
            @foreach (var t in qTypes.Where(t => !string.IsNullOrEmpty(t)))
            {
                <input type="hidden" name="type" value="@t" />
            }
            <input type="hidden" name="country" value="@qCountry" />
            <span style="color:#1B6B23; font-weight:600; font-size:0.92rem;">
                <i class="bi bi-bell"></i>
                @(lang switch
                {
                    "en" => "Want to be alerted about new opportunities matching this search?",
                    "fr" => "Être alerté des nouvelles opportunités correspondant à cette recherche ?",
                    _ => "أتريد تنبيهًا بكل فرصة جديدة تطابق هذا البحث؟"
                })
            </span>
            <button type="submit" class="btn-search-sub" style="margin-inline-start:auto;">
                @(lang switch { "en" => "Save this search", "fr" => "Enregistrer la recherche", _ => "احفظ هذا البحث" })
            </button>
        </form>
    }

    <div class="row g-4">
        @if (!Model.Opportunities.Any())
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted">
                    @(lang switch
                    {
                        "en" => "No opportunities match your search currently!",
                        "fr" => "Aucune opportunité ne correspond à votre recherche pour le moment !",
                        _ => "لا توجد فرص حالياً تطابق بحثك!"
                    })
                </p>
            </div>
        }
        else
        {
            @foreach (var opp in Model.Opportunities)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="opp-card shadow-sm">
                        @if (!string.IsNullOrEmpty(opp.ImagePath))
                        {
                            string title = lang switch
                            {
                                "en" => opp.TitleEn,
                                "fr" => opp.TitleFr,
                                _ => opp.TitleAr
                            };
                            <img src="@opp.ImagePath" class="opp-image" alt="@title" loading="lazy" decoding="async">
                        }

                        <div class="opp-category-row">
                            <span class="type-tag">@opp.Type.GetDisplayName(lang)</span>
                            @if (opp.IsSponsoredNow) { <span class="type-tag sponsored-tag" title="@T("فرصة مموَّلة: تظهر أولًا بمقابل من الجهة، وتبقى مُحقَّقة ومجانية للمتقدم", "Sponsored: shown first for a fee from the organizer; still verified and free to apply", "Sponsorisé : affiché en premier contre paiement ; toujours vérifié et gratuit")">@T("إعلان مموَّل", "Sponsored", "Sponsorisé")</span> }
                            @if (!string.IsNullOrWhiteSpace(opp.AvailableCountriesNames))
                            {
                                var allCountries = opp.AvailableCountriesNames
                                    .Split(',', StringSplitOptions.RemoveEmptyEntries)
                                    .Select(c => c.Trim())
                                    .ToList();

                                var text = string.Join(", ", allCountries.Take(2));

                                if (allCountries.Count > 2)
                                {
                                    text += "...";
                                }

                                <span class="category-tag">@text</span>
                            }
                        </div>

                        @{
                            string title1 = lang switch
                            {
                                "en" => opp.TitleEn,
                                "fr" => opp.TitleFr,
                                _ => opp.TitleAr
                            };
                        }
                        <h3 class="opp-title">@title1</h3>

                        @{
                            string description = lang switch
                            {
                                "en" => opp.DescriptionEn,
                                "fr" => opp.DescriptionFr,
                                _ => opp.DescriptionAr
                            };
                        }

                        @{
                            var plainDescription = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(description, "<.*?>", " ")).Trim(); // فك ترميز الكيانات (3.4)
                            var words = plainDescription.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                            var shortDescription = words.Length > 15 ? string.Join(' ', words.Take(10)) + "..." : plainDescription;
                        }

                        <p class="opp-description">@shortDescription</p>

                        <div>
                            @{
                                bool isExpired = opp.DeadlineType == DeadlineType.SpecificDate && opp.EndDate.HasValue && opp.EndDate.Value.Date < DateTime.Now.Date;

                                // ثلاث حالات: منتهية، تنتهي خلال 7 أيام، متاحة
                                string statusText = isExpired
                                    ? (lang == "en" ? "Application Closed" : lang == "fr" ? "Candidature Terminée" : "انتهت فترة التقديم")
                                    : opp.IsDeadlineSoon
                                        ? (lang == "en" ? "Closing soon" : lang == "fr" ? "Bientôt clôturé" : "ينتهي قريبًا")
                                        : (lang == "en" ? "Available" : lang == "fr" ? "Disponible" : "متاح التقديم");

                                string statusClass = isExpired ? "status-expired" : opp.IsDeadlineSoon ? "status-soon" : "status-available";
                            }

                            <div class="status-wrapper">
                                <span class="opp-status @statusClass">@statusText</span>
                                @if (ViewBag.SaveCounts is Dictionary<int, int> saveCounts && saveCounts.TryGetValue(opp.Id, out var saveCount) && saveCount >= 2)
                                {
                                    <span class="category-tag save-count-tag" style="margin-inline-start:8px;" title="@(lang == "en" ? "People who saved this opportunity" : lang == "fr" ? "Personnes ayant enregistré cette opportunité" : "عدد من حفظوا هذه الفرصة")">
                                        <i class="bi bi-bookmark-fill"></i> @(lang == "en" ? $"{saveCount} saved" : lang == "fr" ? $"{saveCount} favoris" : $"{saveCount} حفظوها")
                                    </span>
                                }
                                @if (ViewBag.MatchScores is Dictionary<int, int> matchScores && matchScores.TryGetValue(opp.Id, out var matchScore))
                                {
                                    var matchClass = matchScore >= 80 ? "match-high" : matchScore >= 50 ? "match-mid" : "match-low";
                                    <span class="match-badge @matchClass" style="position:static; margin-inline-start:8px;"
                                          title="@(lang == "en" ? "How well this matches your interests, nationality and timing" : lang == "fr" ? "Correspondance avec vos intérêts, nationalité et délais" : "مدى مطابقة الفرصة لاهتماماتك وجنسيتك وتوقيتها")">
                                        <i class="bi bi-bullseye"></i> @(lang == "en" ? $"{matchScore}% match" : lang == "fr" ? $"{matchScore} % compatible" : $"تطابق {matchScore}%")
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="opp-info-row">
                            <a href="@Url.Action("Details", "Opportunity", new { id = opp.Id, slug = SlugHelper.Make(title1) })" class="btn-details">@Localizer["view_details"]</a>
                            @await Html.PartialAsync("_SaveButton", (opp.Id, savedIds.Contains(opp.Id)))
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    @if (lp != null && lp.Faq(lang).Count > 0)
    {
        var faq = lp.Faq(lang);
        <section class="ob-faq">
            <h2>@T("أسئلة شائعة", "Frequently asked questions", "Questions fréquentes")</h2>
            @foreach (var item in faq)
            {
                <details><summary>@item.Q</summary><p>@item.A</p></details>
            }
        </section>
        var faqLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "FAQPage",
            ["mainEntity"] = faq.Select(i => new Dictionary<string, object>
            {
                ["@type"] = "Question", ["name"] = i.Q,
                ["acceptedAnswer"] = new Dictionary<string, object> { ["@type"] = "Answer", ["text"] = i.A }
            }).ToList()
        });
        @Html.Raw("<script type=\"application/ld+json\">" + faqLd + "</script>")
    }

    @if (Model.TotalPages > 1)
    {
        <div class="pagination-container mt-5 mb-5">
            <div class="next-page-prompt" style="visibility:@(Model.Page < Model.TotalPages ? "visible" : "hidden")">
                <a href="@PageUrl(Model.Page + 1)">@Localizer["next_page"]</a>
            </div>

            <nav class="pagination-controls" aria-label="pagination">
                <a href="@PageUrl(Model.Page - 1)" rel="prev" class="pagination-arrow prev-arrow @(Model.Page == 1 ? "disabled-link" : "")">
                    <i class="bi bi-chevron-right dir-flip"></i>
                </a>
                @{ int? previousNumber = null; }
                @foreach (var i in pageNumbers)
                {
                    if (previousNumber.HasValue && i - previousNumber.Value > 1)
                    {
                        <span class="page-ellipsis">…</span>
                    }
                    <a href="@PageUrl(i)" class="page-link-num @(i == Model.Page ? "active" : "")">@i</a>
                    previousNumber = i;
                }
                <a href="@PageUrl(Model.Page + 1)" rel="next" class="pagination-arrow next-arrow @(Model.Page == Model.TotalPages ? "disabled-link" : "")">
                    <i class="bi bi-chevron-left dir-flip"></i>
                </a>
            </nav>
        </div>
    }
</div>

<script>
    const filterBtn = document.getElementById('filterToggleBtn');
    const filterWindow = document.getElementById('filterWindow');

    const typeTrigger = document.getElementById('typeOptionTrigger');
    const countryTrigger = document.getElementById('countryOptionTrigger');

    const typeSubMenu = document.getElementById('typeSubMenu');
    const countrySubMenu = document.getElementById('countrySubMenu');

    const cancelSub = document.getElementById('cancelSub');
    const cancelCountrySub = document.getElementById('cancelCountrySub');

    function clearActiveStates() {
        typeTrigger.classList.remove('active');
        countryTrigger.classList.remove('active');
    }

    filterBtn.addEventListener('click', (e) => {
        const isOpening = filterWindow.style.display !== 'block';
        filterWindow.style.display = isOpening ? 'block' : 'none';

        if (!isOpening) {
            typeSubMenu.style.display = 'none';
            countrySubMenu.style.display = 'none';
            clearActiveStates();
        }

        e.stopPropagation();
    });

    typeTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpening = typeSubMenu.style.display !== 'block';

        countrySubMenu.style.display = 'none';
        clearActiveStates();

        if (isOpening) {
            typeSubMenu.style.display = 'block';
            typeTrigger.classList.add('active');
        } else {
            typeSubMenu.style.display = 'none';
        }
    });

    countryTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpening = countrySubMenu.style.display !== 'block';

        typeSubMenu.style.display = 'none';
        clearActiveStates();

        if (isOpening) {
            countrySubMenu.style.display = 'block';
            countryTrigger.classList.add('active');
        } else {
            countrySubMenu.style.display = 'none';
        }
    });

    cancelSub.addEventListener('click', (e) => {
        e.stopPropagation();
        typeSubMenu.style.display = 'none';
        typeTrigger.classList.remove('active');
    });

    cancelCountrySub.addEventListener('click', (e) => {
        e.stopPropagation();
        countrySubMenu.style.display = 'none';
        countryTrigger.classList.remove('active');
    });

    document.addEventListener('click', (e) => {
        if (!filterWindow.contains(e.target) && e.target !== filterBtn) {
            filterWindow.style.display = 'none';
            typeSubMenu.style.display = 'none';
            countrySubMenu.style.display = 'none';
            clearActiveStates();
        }
    });

</script>
<script>
    // فلاتر المرحلة 2.2: أي تغيير يرسل النموذج (الصفحة تعود إلى 1 لأن page ليست في النموذج)
    document.querySelectorAll('#obForm select, #obForm input[type=checkbox]').forEach(function (el) {
        el.addEventListener('change', function () { el.form.submit(); });
    });
</script>
