@model Foras_Khadra.Models.AllOpportunitiesViewModel
@using Foras_Khadra.Helpers
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Globalization;
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    string T(string ar, string en, string fr) => lang == "en" ? en : lang == "fr" ? fr : ar;
    var tp = Model.TypePage;
    var lp = Model.Landing;
    var f = Model.Filter;
    var fc = lp != null ? Model.ExtraFilter : f; // رقائق صفحة النية من معايير الطلب فقط (فلترها المحفوظ لا يُزال)
    // قائمة مخصصة (مثل «تنتهي خلال 7 أيام» 4.3): عنوان ومقدمة وcanonical من الإجراء، وتُفهرس رغم فلترها
    var customTitle = ViewData["ListTitle"] as string;
    var customCanonical = ViewData["ListCanonical"] as string;
    ViewData["Title"] = lp != null ? lp.Title(lang) : tp != null ? tp.Title(lang) : customTitle ?? Localizer["PageTitle"].Value;
    if (lp != null) ViewData["Description"] = lp.Meta(lang);
    else if (tp != null) ViewData["Description"] = tp.Meta(lang);
    // خلاصة Atom مطابقة للصفحة (4.3)
    if (ViewData["FeedUrl"] == null && (lp != null || tp != null)) ViewData["FeedUrl"] = (lang == "ar" ? "" : "/" + lang) + "/feed/" + (lp?.Slug ?? tp!.Slug) + ".xml";

    // canonical (2.2): صفحة النوع والقائمة بلا فلاتر → ذاتي مع رقم الصفحة فقط (لا rel=prev/next)؛
    // أي فلتر أو بحث أو ترتيب → noindex مع canonical ذاتي كامل (لا إشارات متضاربة)
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}";
    var filtered = customCanonical == null && (lp != null ? Model.ExtraFilter.HasCriteria : tp == null ? f.HasCriteria : f.HasCriteriaBeyondType);
    if (filtered)
    {
        ViewData["Robots"] = "noindex,follow";
        ViewData["Canonical"] = baseUrl + Context.Request.Path + Context.Request.QueryString;
    }
    else if (customCanonical != null)
    {
        ViewData["Canonical"] = baseUrl + customCanonical + (Model.Page > 1 ? (customCanonical.Contains('?') ? "&" : "?") + $"page={Model.Page}" : "");
    }
    else
    {
        ViewData["Canonical"] = baseUrl + (lp != null ? Url.Action("ByType", "Home", new { type = lp.Slug }) : tp != null ? Url.Action("ByType", "Home", new { type = tp.Slug }) : Context.Request.Path.Value)
            + (Model.Page > 1 ? $"?page={Model.Page}" : "");
    }
    // صفحة نية غير مكتملة (مسودة، مقدمة قصيرة، أقل من 5 فرص مفتوحة) تظهر لكن لا تُفهرس
    if (lp != null && !Model.LandingIndexable) ViewData["Robots"] = "noindex,follow";

    // رقائق الفلاتر الفعّالة: كل رقاقة رابط يزيل معيارها ويبقي الباقي
    string Without(string key, string? value = null)
    {
        var kept = Context.Request.Query
            .Where(kv => kv.Key != "page" && !(kv.Key.Equals(key, StringComparison.OrdinalIgnoreCase) && (value == null || kv.Value.Any(v => string.Equals(v, value, StringComparison.OrdinalIgnoreCase)))))
            .ToList();
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(Context.Request.Path.Value ?? "/", kept);
    }
    string FundingName(FundingType v) => v switch { FundingType.FullyFunded => T("ممولة بالكامل", "Fully funded", "Entièrement financée"), FundingType.PartiallyFunded => T("ممولة جزئيًا", "Partially funded", "Partiellement financée"), FundingType.SelfFunded => T("على نفقة المتقدم", "Self-funded", "Autofinancée"), FundingType.Paid => T("بأجر", "Paid", "Rémunérée"), _ => "" };
    string DegreeName(DegreeLevels v) => v switch { DegreeLevels.HighSchool => T("ثانوي", "High school", "Lycée"), DegreeLevels.Bachelor => T("بكالوريوس", "Bachelor's", "Licence"), DegreeLevels.Master => T("ماستر", "Master's", "Master"), DegreeLevels.PhD => T("دكتوراه", "PhD", "Doctorat"), DegreeLevels.Postdoc => T("ما بعد الدكتوراه", "Postdoc", "Post-doctorat"), DegreeLevels.Professional => T("مهني", "Professional", "Professionnel"), _ => v.ToString() };
    string ThemeName(GreenThemes v) => v switch { GreenThemes.Climate => T("المناخ", "Climate", "Climat"), GreenThemes.Energy => T("الطاقة", "Energy", "Énergie"), GreenThemes.Water => T("المياه", "Water", "Eau"), GreenThemes.Biodiversity => T("التنوع الحيوي", "Biodiversity", "Biodiversité"), GreenThemes.CircularEconomy => T("الاقتصاد الدائري", "Circular economy", "Économie circulaire"), GreenThemes.Agriculture => T("الزراعة", "Agriculture", "Agriculture"), GreenThemes.SustainableCities => T("المدن المستدامة", "Sustainable cities", "Villes durables"), GreenThemes.Policy => T("السياسات", "Policy", "Politiques"), _ => v.ToString() };
    string FieldName(Field x) => lang == "en" ? x.NameEn : lang == "fr" ? x.NameFr : x.NameAr;

    var chips = new List<(string Label, string Url)>();
    if (fc.Search.Length > 0) chips.Add((T("بحث: ", "Search: ", "Recherche : ") + fc.Search, Without("search")));
    if (tp == null) foreach (var t in fc.Types) chips.Add((t.GetDisplayName(lang), Without("type", t.ToString())));
    if (fc.CountryIso != null) chips.Add((T("دولتي: ", "My country: ", "Mon pays : ") + (fc.CountryIso == "XA" ? T("كل الوطن العربي", "Arab world", "Monde arabe") : Model.CountryOptions.FirstOrDefault(c => c.Iso == fc.CountryIso)?.Name ?? CountryHelper.NameForIso(fc.CountryIso, lang) ?? fc.CountryIso), Without("country")));
    else if (fc.CountryName != null) chips.Add((fc.CountryName, Without("country")));
    if (fc.Funding != null) chips.Add((FundingName(fc.Funding.Value), Without("funding")));
    if (fc.Degree != null) chips.Add((DegreeName(fc.Degree.Value), Without("degree")));
    foreach (var k in fc.Fields) chips.Add((Model.Fields.FirstOrDefault(x => x.Key == k) is Field fld ? FieldName(fld) : k, Without("field", k)));
    if (fc.Theme != null) chips.Add((ThemeName(fc.Theme.Value), Without("theme")));
    if (fc.Host != null) chips.Add((T("في ", "In ", "En ") + (Model.HostOptions.FirstOrDefault(h => h.Iso == fc.Host)?.Name ?? fc.Host), Without("host")));
    if (fc.Remote) chips.Add((T("عن بُعد", "Remote", "À distance"), Without("remote")));
    if (fc.NoIelts) chips.Add((T("بدون آيلتس", "No IELTS", "Sans IELTS"), Without("noielts")));
    if (fc.Women) chips.Add((T("للنساء", "For women", "Pour les femmes"), Without("women")));
    if (fc.Within != null) chips.Add((T($"ينتهي خلال {fc.Within} يومًا", $"Closes within {fc.Within} days", $"Se clôture sous {fc.Within} jours"), Without("within")));
    if (fc.Sort != "open") chips.Add((fc.Sort == "newest" ? T("الأحدث", "Newest", "Plus récentes") : T("الأقرب موعدًا", "Closest deadline", "Échéance proche"), Without("sort")));
    var clearUrl = lp != null ? Url.Action("ByType", "Home", new { type = lp.Slug }) : tp != null ? Url.Action("ByType", "Home", new { type = tp.Slug }) : Url.Action("AllOpportunities", "Home");

    // روابط الصفحات تحافظ على فلاتر البحث الحالية وتغيّر page فقط (type قد تتكرر، لذا لا نجمعها في نص واحد)
    string PageUrl(int p)
    {
        var kept = Context.Request.Query.Where(kv => kv.Key != "page").ToList();
        kept.Add(new KeyValuePair<string, Microsoft.Extensions.Primitives.StringValues>("page", p.ToString()));
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(Context.Request.Path.Value ?? "/", kept);
    }

    var savedIds = ViewBag.SavedIds as HashSet<int> ?? new HashSet<int>();

    var pageNumbers = Enumerable.Range(1, Model.TotalPages)
        .Where(i => i == 1 || i == Model.TotalPages || Math.Abs(i - Model.Page) <= 2)
        .ToList();
}

<link asp-append-version="true" rel="stylesheet" href="~/css/all-opportunities.css" />

<style>
    .custom-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        position: relative;
        margin-bottom: 32px;
        padding: 20px 0;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .header-title {
        margin: 0;
        font-size: 2rem;
        font-weight: 800;
        color: #1e293b;
        letter-spacing: -0.5px;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .filter-window {
        position: absolute;
        top: calc(100% + 10px);
        left: 0;
        min-width: 340px;
        max-width: 380px;
        background: #fff;
        border-radius: 24px;
        border: 1px solid #eef2f7;
        box-shadow: 0 22px 60px rgba(15, 23, 42, 0.14);
        padding: 18px;
        z-index: 1000;
        display: none;
        animation: fadeInUp 0.2s ease;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .filter-window-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
        padding-bottom: 14px;
        border-bottom: 1px solid #eef2f7;
    }

    .sort-by-label {
        font-size: 1rem;
        font-weight: 800;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .reset-link {
        text-decoration: none;
        color: #2e7d32;
        font-size: 0.9rem;
        font-weight: 700;
        transition: 0.2s ease;
    }

    .reset-link:hover {
        color: #256628;
    }

    .filter-window .form-control {
        border-radius: 14px;
        padding: 12px 14px;
        min-height: 46px;
        border: 1px solid #dbe4ee;
        box-shadow: none !important;
        transition: 0.2s ease;
    }

    .filter-window .form-control:focus {
        border-color: #3fa34d;
        box-shadow: 0 0 0 4px rgba(63, 163, 77, 0.12) !important;
    }

    .filter-option-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 16px;
        border-radius: 16px;
        background: #f8fafc;
        border: 1px solid #e8eef5;
        margin-bottom: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
        font-weight: 700;
        color: #334155;
    }

    .filter-option-item:hover {
        background: #f1f8f2;
        border-color: #b7d9bc;
        color: #2e7d32;
    }

    .filter-option-item.active {
        background: linear-gradient(135deg, #eef8ef, #f6fbf7);
        border-color: #9ccca4;
        color: #2e7d32;
        box-shadow: 0 8px 20px rgba(46, 125, 50, 0.08);
    }

    .filter-option-item i {
        font-size: 0.9rem;
    }

    .sub-filter-menu {
        display: none;
        background: #f8fafc;
        border: 1px solid #e8eef5;
        border-radius: 18px;
        padding: 14px;
        margin-top: 12px;
    }

    .checkbox-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        margin-bottom: 8px;
        border-radius: 12px;
        cursor: pointer;
        transition: 0.2s ease;
        color: #334155;
        font-weight: 600;
    }

    .checkbox-item:hover {
        background: #eef8ef;
    }

    .checkbox-item input[type="checkbox"] {
        width: 18px;
        height: 18px;
        accent-color: #2e7d32;
        cursor: pointer;
    }

    .sub-menu-footer {
        display: flex;
        gap: 10px;
        justify-content: space-between;
        margin-top: 14px;
    }

    .btn-cancel-sub,
    .btn-search-sub {
        flex: 1;
        border: none;
        border-radius: 14px;
        padding: 11px 14px;
        font-weight: 700;
        transition: 0.2s ease;
    }

    .btn-cancel-sub {
        background: #eef2f7;
        color: #475569;
    }

    .btn-cancel-sub:hover {
        background: #e2e8f0;
    }

    .btn-search-sub {
        background: linear-gradient(135deg, #2e7d32, #3fa34d);
        color: #fff;
        box-shadow: 0 10px 24px rgba(46, 125, 50, 0.16);
    }

    .btn-search-sub:hover {
        transform: translateY(-1px);
        box-shadow: 0 14px 28px rgba(46, 125, 50, 0.22);
    }

    .opp-card {
        background: #fff;
        border-radius: 22px;
        overflow: hidden;
        border: 1px solid #eef2f7;
        transition: all 0.25s ease;
        height: 100%;
    }

    .opp-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 34px rgba(15, 23, 42, 0.08);
    }

    .opp-image {
        width: 100%;
        height: 220px;
        object-fit: cover;
    }

    .opp-category-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 16px 18px 0;
    }

    .type-tag,
    .category-tag {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 7px 12px;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .type-tag {
        background: #edf7ee;
        color: #2e7d32;
    }

    .category-tag {
        background: #f1f5f9;
        color: #475569;
    }

    .opp-title {
        padding: 14px 18px 0;
        font-size: 1.1rem;
        font-weight: 800;
        color: #1e293b;
        line-height: 1.6;
        margin: 0;
    }

    .opp-description {
        padding: 10px 18px 0;
        color: #64748b;
        font-size: 0.95rem;
        line-height: 1.8;
        min-height: 72px;
        margin-bottom: 0;
    }

    .status-wrapper {
        padding: 16px 18px 0;
    }

    .opp-status {
        display: inline-flex;
        align-items: center;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 800;
    }

    .status-available {
        background: #edf7ee;
        color: #2e7d32;
    }

    .status-expired {
        background: #fff1f2;
        color: #dc2626;
    }

    .status-soon {
        background: #fff3e0;
        color: #c2410c;
    }

    .page-ellipsis {
        padding: 0 4px;
        color: #94a3b8;
        font-weight: 700;
    }

    .opp-info-row {
        padding: 18px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .opp-info-row .btn-details {
        flex: 1;
    }

    .pagination-container {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
        flex-wrap: wrap;
    }

    .next-page-prompt a {
        text-decoration: none;
        font-weight: 700;
        color: #2e7d32;
    }

    .pagination-controls {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .pagination-arrow,
    .page-link-num {
        width: 42px;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        text-decoration: none;
        background: #fff;
        border: 1px solid #e5e7eb;
        color: #334155;
        font-weight: 700;
        transition: 0.2s ease;
    }

    .pagination-arrow:hover,
    .page-link-num:hover,
    .page-link-num.active {
        background: #2e7d32;
        color: #fff;
        border-color: #2e7d32;
    }

    .disabled-link {
        pointer-events: none;
        opacity: 0.45;
    }

    @@media (max-width: 991px) {
        .filter-window {
            left: 0;
            right: 0;
            min-width: unset;
            max-width: 100%;
            width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .custom-header {
            flex-direction: column;
            align-items: stretch;
        }

        .header-right,
        .header-left {
            justify-content: space-between;
        }

        .header-title {
            font-size: 1.5rem;
        }

        .opp-image {
            height: 200px;
        }

        .filter-window {
            padding: 14px;
            border-radius: 20px;
        }
    }
</style>

<style>
    /* ===== المرحلة 2.2: بحث ظاهر، فلاتر مهيكلة، رقائق، عدّاد ===== */
    .ob-intro { color: #475569; line-height: 1.9; max-width: 900px; margin: 0 0 16px; }
    .ob-bar { background: #fff; border: 1px solid #DCEFDD; border-radius: 16px; padding: 12px; margin-bottom: 10px; }
    .ob-search { display: flex; align-items: center; gap: 8px; border: 1px solid #CBD5E1; border-radius: 12px; padding: 4px 6px 4px 12px; }
    .ob-search i { color: #94A3B8; }
    .ob-search input { flex: 1; border: 0; outline: 0; font: inherit; padding: 8px 0; min-width: 0; background: transparent; }
    .ob-search button { border: 0; background: #1B6B23; color: #fff; border-radius: 10px; padding: 8px 16px; font: inherit; font-weight: 700; cursor: pointer; }
    .ob-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .ob-filters select { border: 1px solid #CBD5E1; border-radius: 999px; padding: 6px 12px; font: inherit; font-size: .9rem; background: #fff; max-width: 220px; }
    .ob-filters select:has(option:checked:not([value=""])) { background: #E8F5E9; border-color: #1B6B23; color: #1B6B23; font-weight: 700; }
    .ob-toggle { display: inline-flex; align-items: center; gap: 6px; border: 1px solid #CBD5E1; border-radius: 999px; padding: 6px 12px; font-size: .9rem; cursor: pointer; }
    .ob-toggle:has(input:checked) { background: #E8F5E9; border-color: #1B6B23; color: #1B6B23; font-weight: 700; }
    .ob-toggle input { accent-color: #1B6B23; }
    .ob-status { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin: 0 0 14px; }
    .ob-count { color: #475569; }
    .ob-count b { color: #1B6B23; font-size: 1.1rem; }
    .ob-chip { display: inline-flex; align-items: center; gap: 4px; background: #E8F5E9; color: #1B6B23; border-radius: 999px; padding: 4px 10px; font-size: .85rem; font-weight: 700; text-decoration: none; }
    .ob-chip:hover { background: #d4ecd6; color: #1B6B23; }
    .ob-clear { color: #B91C1C; font-size: .85rem; text-decoration: none; }
