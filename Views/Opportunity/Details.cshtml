@using System.Globalization
@model Foras_Khadra.Models.Opportunity
@using Foras_Khadra.Helpers
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    string pageTitle = lang switch
    {
        "en" => Model.TitleEn,
        "fr" => Model.TitleFr,
        _ => Model.TitleAr
    };
    ViewData["Title"] = pageTitle;

    var isExpired = false;
    if (Model.DeadlineType == DeadlineType.SpecificDate && Model.EndDate.HasValue)
    {
        isExpired = Model.EndDate.Value.Date < DateTime.Now.Date;
    }

    var applyButtonClass = "apply-button " + (isExpired ? "expired-button" : "active-button");

    var isRtl = lang == "ar";
    var dir = isRtl ? "rtl" : "ltr";

    string title = lang switch
    {
        "en" => Model.TitleEn,
        "fr" => Model.TitleFr,
        _ => Model.TitleAr
    };

    // ===== SEO: وصف الصفحة وصورتها ورابطها القانوني (بالـ slug) وبيانات JobPosting المنظمة =====
    string seoDescriptionHtml = lang switch { "en" => Model.DescriptionEn, "fr" => Model.DescriptionFr, _ => Model.DescriptionAr };
    string seoDetailsHtml = lang switch { "en" => Model.DetailsEn, "fr" => Model.DetailsFr, _ => Model.DetailsAr };
    string Plain(string? html) => System.Text.RegularExpressions.Regex.Replace(
        System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(html ?? "", "<.*?>", " ")), @"\s+", " ").Trim();

    var plainDescription = Plain(seoDescriptionHtml);
    ViewData["Description"] = plainDescription.Length > 160 ? plainDescription.Substring(0, 157) + "..." : plainDescription;
    ViewData["OgType"] = "article";
    if (!string.IsNullOrEmpty(Model.ImagePath)) ViewData["OgImage"] = Model.ImagePath;

    var canonicalUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}"
        + Url.Action("Details", "Opportunity", new { id = Model.Id, slug = SlugHelper.Make(title) });
    ViewData["Canonical"] = canonicalUrl;

    // Google for Jobs يفهم JobPosting للوظائف والتدريب فقط؛ بقية الأنواع تكتفي بوسوم الصفحة
    string? jobPostingJson = null;
    if (Model.Type == OpportunityType.Jobs || Model.Type == OpportunityType.Internships)
    {
        var publisherName = Model.IsPublishedByAdmin || string.Equals(Model.PublishedBy, "admin", StringComparison.OrdinalIgnoreCase)
            ? "فرص خضراء"
            : (string.IsNullOrWhiteSpace(Model.PublishedBy) ? "فرص خضراء" : Model.PublishedBy);

        var countryNames = (Model.AvailableCountries ?? new List<Country>())
            .Select(c => lang switch { "en" => c.NameEn, "fr" => c.NameFr, _ => c.NameAr })
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .ToList();

        var jobPosting = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "JobPosting",
            ["title"] = title,
            ["description"] = string.Join("\n\n", new[] { plainDescription, Plain(seoDetailsHtml) }.Where(s => s.Length > 0)),
            ["datePosted"] = Model.PublishDate.ToString("yyyy-MM-dd"),
            ["validThrough"] = Model.DeadlineType == DeadlineType.SpecificDate && Model.EndDate.HasValue
                ? Model.EndDate.Value.ToString("yyyy-MM-dd") : null,
            ["employmentType"] = Model.Type == OpportunityType.Internships ? "INTERN" : null,
            ["hiringOrganization"] = new Dictionary<string, object?> { ["@type"] = "Organization", ["name"] = publisherName },
            ["jobLocation"] = countryNames.Select(n => new Dictionary<string, object?>
            {
                ["@type"] = "Place",
                ["address"] = new Dictionary<string, object?> { ["@type"] = "PostalAddress", ["addressCountry"] = n }
            }).ToList(),
            ["url"] = canonicalUrl,
            ["directApply"] = false
        };

        // المشفّر الافتراضي يهرّب < و > فلا يمكن كسر وسم script من نص الفرصة
        jobPostingJson = System.Text.Json.JsonSerializer.Serialize(jobPosting, new System.Text.Json.JsonSerializerOptions
        {
            DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull
        });
    }
}

<link asp-append-version="true" href="~/css/opportunity-deatails.css" rel="stylesheet" />
@if (jobPostingJson != null)
{
    <script type="application/ld+json">@Html.Raw(jobPostingJson)</script>
}

<div class="opp-container" dir="@dir">

    <!-- ===== Top bar (title + back + apply) ===== -->
    <div class="opp-top">
        <div class="opp-header">
            <div class="btn-back-container">
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Opportunity" asp-action="Index" class="back-link"><span class="back-arrow">↪</span></a>
                }
                else if (User.IsInRole("Organization"))
                {
                    <a asp-controller="Opportunity" asp-action="OrgOpportunities" class="back-link"><span class="back-arrow">↪</span></a>
                }
                else
                {
                    <a asp-controller="Home" asp-action="AllOpportunities" class="back-link"><span class="back-arrow">↪</span></a>
                }
            </div>

            <div class="opp-title">
                <span>@title</span>
            </div>
        </div>

        <div class="opp-actions">
            @if (User.IsInRole("Admin") || User.IsInRole("User") || User.IsInRole("Organization"))
            {
                <a id="applyBtn"
                   href="@(isExpired ? "javascript:void(0);" : Model.ApplyLink)"
                   target="@(isExpired ? "_self" : "_blank")"
                   class="@applyButtonClass"
                   @(isExpired ? "title='الفرصة منتهية'" : "")>
                    @Localizer["ApplyNow"]
                </a>
                @await Html.PartialAsync("_SaveButton", (Model.Id, (ViewBag.IsSaved as bool?) == true))
                @if (isExpired && !User.IsInRole("Organization"))
                {
                    var watching = (ViewBag.IsWatching as bool?) == true;
                    <form method="post" asp-controller="Tracker" asp-action="ToggleCycleWatch" asp-route-id="@Model.Id" style="display:inline;">
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <button type="submit" class="save-btn @(watching ? "is-saved" : "")"
                                title="@(watching
                                    ? (lang == "en" ? "You'll be notified when the next cycle opens — click to cancel" : lang == "fr" ? "Vous serez averti à la prochaine session — cliquer pour annuler" : "ستُعلَم عند فتح الدورة القادمة — اضغط للإلغاء")
                                    : (lang == "en" ? "Notify me when the next cycle opens" : lang == "fr" ? "M'avertir à l'ouverture de la prochaine session" : "أعلمني حين تفتح الدورة القادمة"))"
                                aria-pressed="@(watching ? "true" : "false")">
                            <i class="bi @(watching ? "bi-bell-fill" : "bi-bell")"></i>
                        </button>
                    </form>
                }
                @if (!isExpired && Model.DeadlineType == DeadlineType.SpecificDate && Model.EndDate.HasValue)
                {
                    <a class="save-btn" href="@Url.Action("Calendar", "Opportunity", new { id = Model.Id })"
                       title="@(lang == "en" ? "Remind me — add the deadline to my calendar" : lang == "fr" ? "Me rappeler — ajouter la date limite à mon agenda" : "ذكّرني بالموعد — أضفه إلى تقويمي")"
                       aria-label="@(lang == "en" ? "Add deadline to calendar" : lang == "fr" ? "Ajouter la date limite à l'agenda" : "أضف الموعد إلى التقويم")">
                        <i class="bi bi-calendar-plus"></i>
                    </a>
                }
            }
            else if (!User.Identity.IsAuthenticated)
            {
                <a id="applyBtn"
                   href="javascript:void(0);"
                   class="@applyButtonClass"
                   data-guest="1">
                    @Localizer["ApplyNow"]
                </a>
                @* للزائر: نفس نافذة "تسجيل الدخول مطلوب" الخاصة بزر التقديم *@
                <button type="button" class="save-btn" id="saveGuestBtn" title="@(lang == "en" ? "Save" : lang == "fr" ? "Enregistrer" : "حفظ الفرصة")">
                    <i class="bi bi-bookmark"></i>
                </button>
            }
        </div>
    </div>

    <!-- ===== Main Card (Image + Info side by side on desktop) ===== -->
    <div class="main-card">

        <!-- Image -->
        <div class="card-image-wrapper" id="oppImage">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="@Model.ImagePath" alt="Opportunity Image" />
            }
            else
            {
                <div style="background:#eee; height:100%; min-height:220px;"></div>
            }
        </div>

        <!-- Info Card -->
        <div class="card-info-content" id="oppInfoCard">
            <div class="info-grid">

                <span class="info-label">@Localizer["PublishDate"]</span>
                <span class="info-value">@Model.PublishDate.ToShortDateString()</span>

                <span class="info-label">@Localizer["Deadline"]</span>
                <span class="info-value">
                    @{
                        string deadlineText = "";
                        string deadlineClass = "";

                        if (Model.DeadlineType == DeadlineType.SpecificDate && Model.EndDate.HasValue)
                        {
                            deadlineText = Model.EndDate.Value.ToShortDateString();
                            deadlineClass = isExpired ? "deadline-expired" : "deadline-active";

                            if (!isExpired && Model.IsDeadlineSoon)
                            {
                                deadlineClass = "deadline-soon";
                                deadlineText += " · " + (lang == "en" ? "Closing soon" : lang == "fr" ? "Bientôt clôturé" : "ينتهي قريبًا");
                            }
                        }
                        else if (Model.DeadlineType == DeadlineType.UntilFull)
                        {
                            deadlineText = Localizer["UntilFull"].Value;
                            deadlineClass = "deadline-active";
                        }
                        else
                        {
                            deadlineText = Localizer["NotSpecified"].Value;
                            deadlineClass = "deadline-active";
                        }
                    }
                    <span class="deadline-label @deadlineClass">@deadlineText</span>
                </span>

                <span class="info-label">@Localizer["OpportunityType"]</span>
                <span class="info-value">@Model.Type.GetDisplayName(lang)</span>

                <span class="info-label">@Localizer["Publisher"]</span>
                <span class="info-value">
                    @{
                        string publisherText;
                        if (Model.IsPublishedByAdmin)
                        {
                            publisherText = lang switch
                            {
                                "ar" => "فرص خضراء",
                                _ => "Foras Khadra"
                            };
                        }
                        else
                        {
                            publisherText = Model.PublishedBy;
                        }
                    }
                    @publisherText

                    @if (Model.IsPublishedByAdmin)
                    {
                        <iconify-icon icon="mdi:check-decagram"
                                      style="color:#25652C; font-size:20px; vertical-align:middle;">
                        </iconify-icon>
                    }
                </span>

                <span class="info-label">@Localizer["AvailableCountries"]</span>
                <span class="info-value">
                    @string.Join(", ", Model.AvailableCountries.Select(c =>
                        lang switch
                        {
                            "en" => c.NameEn,
                            "fr" => c.NameFr,
                            _ => c.NameAr
                        }))
                </span>

                <span class="info-label">@Localizer["Description"]</span>
                @{
                    string description = lang switch
                    {
                        "en" => Model.DescriptionEn,
                        "fr" => Model.DescriptionFr,
                        _ => Model.DescriptionAr
                    };
                }
                <span class="info-value">@Html.SanitizedRaw(description)</span>

            </div>
        </div>

    </div>

    <!-- ===== Details Card ===== -->
    <div class="details-card">
        <div class="section-title @(lang == "ar" ? "rtl-label" : "ltr-label")">@Localizer["Details"]</div>
        @{
            string details = lang switch
            {
                "en" => Model.DetailsEn,
                "fr" => Model.DetailsFr,
                _ => Model.DetailsAr
            };
            string detailsClass = (lang == "en" || lang == "fr") ? "section-content ltr-content" : "section-content";
        }
        <div class="@detailsClass">@Html.SanitizedRaw(details)</div>

        <div class="section-title @(lang == "ar" ? "rtl-label" : "ltr-label")">@Localizer["EligibilityCriteria"]</div>
        @{
            string eligibilitycriteria = lang switch
            {
                "en" => Model.EligibilityCriteriaEn,
                "fr" => Model.EligibilityCriteriaFr,
                _ => Model.EligibilityCriteriaAr
            };
            string eligibilityClass = (lang == "en" || lang == "fr") ? "section-content ltr-content" : "section-content";
        }
        <div class="@eligibilityClass">@Html.SanitizedRaw(eligibilitycriteria)</div>

        <div class="section-title @(lang == "ar" ? "rtl-label" : "ltr-label")">@Localizer["Benefits"]</div>
        @{
            string benefits = lang switch
            {
                "en" => Model.BenefitsEn,
                "fr" => Model.BenefitsFr,
                _ => Model.BenefitsAr
            };
            string benefitsClass = (lang == "en" || lang == "fr") ? "section-content ltr-content" : "section-content";
        }
        <div class="@benefitsClass">@Html.SanitizedRaw(benefits)</div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const currentLang = '@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName';
        const registerUrl = '@Url.Action("RegisterUser", "Account")';
        const loginUrl = '@Url.Action("Login", "Account")';

        const swalTexts = {
            title: 'تسجيل الدخول مطلوب !',
            html: 'أنشئ حساب لتتمكن من التقديم ، وإذا كان لديك حساب بالفعل<br>سجل الدخول الآن',
            registerButton: 'إنشاء حساب',
            loginButton: 'تسجيل الدخول',
            dir: 'rtl'
        };

        if(currentLang === 'en') {
            swalTexts.title = 'Login Required!';
            swalTexts.html = 'Create an account to apply, or login if you already have one.';
            swalTexts.registerButton = 'Register';
            swalTexts.loginButton = 'login';
            swalTexts.dir = 'ltr';
        }
        else if(currentLang === 'fr') {
            swalTexts.title = 'Connexion requise !';
            swalTexts.html = 'Créez un compte pour postuler, ou connectez-vous si vous en avez déjà un.';
            swalTexts.registerButton = 'Créer un compte';
            swalTexts.loginButton = 'Se connecter';
            swalTexts.dir = 'ltr';
        }

        document.getElementById('saveGuestBtn')?.addEventListener("click", function () {
            document.querySelector('#applyBtn[data-guest="1"]')?.click();
        });

        document.querySelector('#applyBtn[data-guest="1"]')?.addEventListener("click", function () {
            Swal.fire({
                imageUrl: '/images/login-required.svg',
                imageWidth: 165,
                imageHeight: 129,
                imageAlt: 'Login required illustration',
                title: swalTexts.title,
                html: swalTexts.html,
                showDenyButton: true,
                showCancelButton: false,
                confirmButtonText: swalTexts.registerButton,
                denyButtonText: swalTexts.loginButton,
                customClass: {
                    popup: 'custom-swal-popup',
                    title: 'custom-swal-title',
                    htmlContainer: 'custom-swal-text',
                    confirmButton: 'custom-swal-confirm',
                    denyButton: 'custom-swal-confirm',
                    closeButton: 'custom-swal-close'
                },
                showCloseButton: true,
                buttonsStyling: false,
                didOpen: () => {
                    const popup = Swal.getPopup();
                    popup.style.border = '1px solid #C77E1F';
                    popup.style.borderRadius = '16px';
                    popup.style.paddingBottom = '25px';
                    popup.style.paddingTop = '20px';
                    popup.style.width = '740px';
                    popup.style.direction = swalTexts.dir;
                    popup.querySelector('.swal2-title')?.setAttribute('dir', swalTexts.dir);
                    popup.querySelector('.swal2-html-container')?.setAttribute('dir', swalTexts.dir);

                    const denyButton = popup.querySelector('.swal2-deny');
                    if (denyButton) {
                        denyButton.style.backgroundColor = '#25652C';
                    }
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = registerUrl;
                } else if (result.isDenied) {
                    window.location.href = loginUrl;
                }
            });
        });
    </script>
}