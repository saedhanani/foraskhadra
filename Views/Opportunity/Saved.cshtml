@model Foras_Khadra.Models.MyOpportunitiesViewModel
@using Foras_Khadra.Models
@{
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    string T(string ar, string en, string fr) => lang == "en" ? en : lang == "fr" ? fr : ar;
    var pageTitle = T("فرصي", "My opportunities", "Mes opportunités");
    ViewData["Title"] = pageTitle;
    ViewData["Description"] = pageTitle;

    // مجموعة من صفوف _MyOpportunityRow بعنوان وعدد
    async Task Group(string css, string icon, string title, List<MyOpportunityItem> items, bool collapsed = false)
    {
        if (!items.Any()) return;
        if (collapsed)
        {
            <details class="my-group @css">
                <summary class="my-group__title"><i class="bi @icon"></i> @title <span class="count">@items.Count</span></summary>
                <div class="my-list">
                    @foreach (var item in items) { await Html.RenderPartialAsync("_MyOpportunityRow", item); }
                </div>
            </details>
        }
        else
        {
            <section class="my-group @css">
                <h2 class="my-group__title"><i class="bi @icon"></i> @title <span class="count">@items.Count</span></h2>
                <div class="my-list">
                    @foreach (var item in items) { await Html.RenderPartialAsync("_MyOpportunityRow", item); }
                </div>
            </section>
        }
    }
}

<link asp-append-version="true" rel="stylesheet" href="~/css/tracker.css" />
<link asp-append-version="true" rel="stylesheet" href="~/css/my-opps.css" />

<div class="my-page">
    <header class="my-head">
        <h1><i class="bi bi-bookmark-star-fill"></i> @pageTitle</h1>
        <a class="my-head__browse" href="@Url.Action("AllOpportunities", "Home")">@T("+ أضف فرصًا", "+ Add more", "+ Ajouter")</a>
    </header>

    @await Html.PartialAsync("_PushCard", "full")

    @if (Model.Total == 0)
    {
        <div class="my-empty">
            <i class="bi bi-bookmark-plus"></i>
            <p>
                @T("هنا تجتمع كل فرصك: احفظ أي فرصة بزر", "All your opportunities live here: save any opportunity with the", "Toutes vos opportunités sont ici : enregistrez-en une avec le bouton")
                <i class="bi bi-bookmark"></i>
                @T("وسنعرض لك كم بقي على موعدها ونذكّرك قبل أن ينتهي.", "button and we'll count down to its deadline and remind you before it closes.", "et nous suivrons son échéance et vous la rappellerons.")
            </p>
            <a class="my-btn" href="@Url.Action("AllOpportunities", "Home")"><i class="bi bi-compass"></i> @T("تصفّح الفرص", "Browse opportunities", "Parcourir les opportunités")</a>
        </div>
    }
    else
    {
        <div class="my-stats">
            <div class="my-stat"><b>@Model.Total</b><span>@T("محفوظة", "Saved", "Enregistrées")</span></div>
            <div class="my-stat"><b>@Model.AppliedCount</b><span>@T("قدّمت عليها", "Applied", "Candidatures")</span></div>
            <div class="my-stat"><b>@Model.AcceptedCount</b><span>@T("قُبلت", "Accepted", "Acceptées")</span></div>
        </div>

        @* تقويم webcal شخصي (4.3): كل مواعيدك المحفوظة في تقويم هاتفك، يتجدد تلقائيًا *@
        @if (ViewBag.WebcalPath is string webcalPath)
        {
            var webcal = "webcal://" + Context.Request.Host + webcalPath;
            var https = Context.Request.Scheme + "://" + Context.Request.Host + webcalPath;
            <div class="webcal-box">
                <i class="bi bi-calendar-plus" aria-hidden="true"></i>
                <span>@T("اشترك بتقويم مواعيدك: يظهر كل موعد محفوظ في تقويم هاتفك ويتجدد وحده.", "Subscribe to your deadlines calendar: every saved deadline shows in your phone calendar and refreshes itself.", "Abonnez-vous à votre calendrier : chaque échéance enregistrée apparaît dans l'agenda de votre téléphone et se met à jour seule.")</span>
                <a class="fk-btn fk-btn-primary" href="@webcal">@T("أضف إلى التقويم", "Add to calendar", "Ajouter à l'agenda")</a>
                <button type="button" class="fk-btn fk-btn-ghost" onclick="navigator.clipboard && navigator.clipboard.writeText('@https').then(() => { this.textContent = '@T("نُسخ ✓", "Copied ✓", "Copié ✓")'; })">@T("انسخ الرابط (Google Calendar)", "Copy link (Google Calendar)", "Copier le lien (Google Agenda)")</button>
            </div>
        }

        await Group("my-group--urgent", "bi-alarm", T("تنتهي قريبًا", "Closing soon", "Bientôt clôturées"), Model.Urgent);
        await Group("", "bi-hourglass-split", T("قيد التحضير", "To prepare", "À préparer"), Model.Preparing);
        await Group("", "bi-send-check", T("قدّمت عليها", "Applied", "Candidatures envoyées"), Model.Applied);
        await Group("", "bi-trophy", T("النتائج", "Results", "Résultats"), Model.Results);
        await Group("", "bi-archive", T("انتهى موعدها", "Closed", "Clôturées"), Model.Expired, collapsed: true);
    }
</div>
