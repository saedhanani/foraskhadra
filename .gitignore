# Build output
.vs/
bin/
obj/
buildtemp/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ll]og/
[Ll]ogs/
publish/
artifacts/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser

# Publish profiles may contain deployment credentials
*.pubxml.user
*.publishsettings
PublishScripts/

# Secrets: keep real settings local, commit appsettings.example.json instead
appsettings.json
appsettings.*.json
!appsettings.example.json
secrets.json
*.env
.env

# Data-protection keys (auth cookies / CSRF) are per-server secrets
App_Data/

# User uploads (opportunity images, logos, article/team photos) live on the server, not in git
wwwroot/uploads/**
!wwwroot/uploads/**/
!wwwroot/uploads/**/.gitkeep
wwwroot/logos/**
!wwwroot/logos/**/
!wwwroot/logos/**/.gitkeep

# Test / coverage results
[Tt]est[Rr]esult*/
*.trx
coverage*.json
coverage*.xml

# NuGet
*.nupkg
*.snupkg
packages/
!**/packages/build/

# Editors / OS
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# Brand source assets (1.7 GB, local only — web copies live in wwwroot/fonts/brand + wwwroot/images/brand)
Foras Khadraa brand-*/
