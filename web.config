<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Foras_Khadra.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <!-- حد IIS لجسم الطلب (32 ميغابايت). يجب أن يبقى أعلى من حد التطبيق لصورة الغلاف من منصة الفريق
           (TeamApiController.ImageRequestMaxBytes = 20 ميغابايت)، وإلا ردّ IIS بـ 404.13 بدل 413 من التطبيق -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="33554432" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
